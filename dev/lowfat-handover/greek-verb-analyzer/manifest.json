{
  "manifest_version": 3,
  "name": "Greek Verb Analyzer",
  "version": "2.2.3",
  "description": "コイネー・ギリシャ語の動詞解析ツール（閲覧中の聖書ページに解析パネルを表示。統語論ビュー付き）",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "解析パネルを表示/非表示"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bible.com/*",
        "*://prs.app/*",
        "*://*.prs.app/*",
        "*://prsi.org/*",
        "*://*.prsi.org/*",
        "*://*.biblegateway.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "解析パネルを表示/非表示"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "syntax/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}