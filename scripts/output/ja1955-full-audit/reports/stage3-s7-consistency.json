  "s6_improvements": [
    {
      "id": "IMP-1",
      "title": "SR 種別フラグの追加（`sr_type`フィールド）",
      "target": "analyzeToken() の返却値",
      "design": "\n      sr_type: \"same_strong\"       // 同Strong同節反復\n             | \"cross_strong\"      // 異Strongの同ラベル衝突（非BL、非S4）\n             | \"cross_strong_bl\"   // 異Strongで衝突相手がBL\n             | \"cross_strong_s4\"   // 異Strongで衝突相手がS4除外\n             | \"cross_strong_pool\" // 異Strongで衝突相手もpool内\n             | \"mixed\"             // 複数種類が同時発生（MAT 13:14等）\n    ",
      "benefit": "SR の内訳を定量化できる。BL/S4との衝突をpoolとの衝突から分離して集計可能。",
      "limitation": "現在のスクリプトの大規模改修は不要。analyzeToken()に数行追加するだけ。"
    },
    {
      "id": "IMP-2",
      "title": "クロス Strong 衝突マップの事前生成（`cross_strong_map.json`）",
      "target": "pool 全体の前処理",
      "design": "\n      // 全Strong×書巻 の Japanese ラベルを比較し、\n      // 同一書巻内で同一Japaneseを持つStrong番号の組み合わせを列挙\n      // 例: { \"G2036|G3004\": { japanese:\"言う\", books:[\"JHN\",\"ACT\"], count:3 } }\n    ",
      "benefit": "どの Strong ペアが日本語ラベル衝突リスクを持つかを事前把握できる。衝突頻度の高いペアを優先的に人的確認の対象にできる。",
      "limitation": "pool規模では計算コスト小。ただし「同一節」でなく「同一書巻」での衝突を列挙するため false positive が増える。"
    },
    {
      "id": "IMP-3",
      "title": "BL/除外Strong との衝突を SR カウントから分離する仕組み",
      "target": "サンプル集計ロジック",
      "design": "\n      // SR を以下の3つに分離して集計:\n      // sr_resolvable:   BL/S4との衝突のみ → G2532等は監査対象外なので\n      //                  JA1955帰属が決定不能だが \"G5037が対応先\" と仮定可能\n      // sr_unresolvable: 両方がpoolトークン → どちらかが誤Japanese\n      // sr_mixed:        上記の複合\n      // 公式SR率 = sr_resolvable + sr_unresolvable + sr_mixed（現行維持）\n      // 参考値   = sr_unresolvable のみ（BL除外時の最小SR）\n    ",
      "benefit": "「BLとの共存」と「pool内トークン同士の衝突」という質的に異なる問題を分離して管理できる。",
      "limitation": "「BL/S4との衝突はSRとしてカウントするか」のポリシーが別途必要。"
    },
    {
      "id": "IMP-4",
      "title": "位置順ベースの帰属推定（実験的）",
      "target": "duplicate_label 解消の試み",
      "design": "\n      // 同Strong反復の場合:\n      // 節内の globalIdx 順に並べたとき、「n番目のトークン → JA1955の先頭から n番目の同表現」\n      // という仮定で帰属推定\n      // 成立条件: JA1955がギリシャ語語順に比較的忠実な場合\n      // 非成立条件: 語順転置が起きている場合（倒置強調等）\n    ",
      "benefit": "duplicate_label SR の一部を「帰属推定あり（provisional explicit）」として扱い、SR率の定性的な説明を改善できる。",
