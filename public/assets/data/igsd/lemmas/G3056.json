{
 "lemma": "λόγος",
 "lemmaId": "grc:G3056",
 "strong": "G3056",
 "status": "final",
 "updated": "2026-11-10",
 "senses": [
  {
   "id": "1",
   "label": "言葉・発言",
   "label_en": "word / saying",
   "def": "内なる思考を表現する具体的な言語表現。意味のまとまりを持つ発言・ことば・言い回しを指す。",
   "note": "マタ8:8「ただ言葉を言ってください」、コリ一14:9、ヘブ12:19。"
  },
  {
   "id": "2",
   "label": "み言葉・福音の言葉",
   "label_en": "the word / word of the gospel",
   "def": "神・主・キリストが与えたとされる教え・命令・約束の全体、とりわけ宣教や弟子形成の場で伝達される福音のメッセージを指す。",
   "note": "マコ4:14-20（種まきの比喩）、ὁ λ. τοῦ θεοῦ（マコ7:13, ロマ9:6）、ὁ λ. τοῦ κυρίου（使8:25, テサ一1:8）、ルカ1:2、使6:4。"
  },
  {
   "id": "3",
   "label": "語り・言論（談話・演説）",
   "label_en": "speech / discourse (talk / address)",
   "def": "話す行為そのもの、あるいは語りの様式・能力としての言論。文書・行い・力と対比される場合に特に際立つ。",
   "note": "コリ二10:10、使14:12、ヤコ3:2。ἐν λόγῳ μόνον（テサ一1:5）。"
  },
  {
   "id": "4",
   "label": "事柄・問題",
   "label_en": "matter / affair",
   "def": "話題として取り上げられる事案・事柄・問題。法的な係争案件から日常的な話題まで幅広く現れる。",
   "note": "マコ1:45、使8:21、使19:38、マタ21:24。"
  },
  {
   "id": "5",
   "label": "計算・精算・説明責任",
   "label_en": "reckoning / account / accountability",
   "def": "金銭や行為についての勘定・清算・報告を義務として求められる「説明責任」。「誰かに対して計算（λόγον）を提出する」という形で現れる。",
   "note": "マタ18:23（συναίρειν λόγον）、マタ25:19、マタ12:36、ロマ14:12、ヘブ13:17、ペテ一4:5。フィリ4:15, 17も同系。"
  },
  {
   "id": "6",
   "label": "理由・根拠",
   "label_en": "reason / ground",
   "def": "ある行為や判断の根拠として示される理由・理屈・正当な事由。",
   "note": "使10:29（τίνι λόγῳ）、使18:14（κατὰ λόγον）、マタ5:32（παρεκτὸς λόγου πορνείας）。"
  },
  {
   "id": "7",
   "label": "言（ロゴス・神の言）",
   "label_en": "the Word (Logos / the Word of God)",
   "def": "世界の創造・啓示・救済の源泉として人格的に描かれる神の言。ヨハネ文書においては受肉したキリストと同定される。",
   "note": "ヨハ1:1（3回）、ヨハ1:14、ヨハ一1:1、黙19:13。"
  }
 ],
 "idioms": [
  {
   "form": "συναίρω λόγον",
   "gloss": "精算する・清算の場を設ける。金銭または行為についての計算・報告を求める定型表現",
   "refs": [
    "MAT 18:23",
    "MAT 25:19"
   ]
  }
 ],
