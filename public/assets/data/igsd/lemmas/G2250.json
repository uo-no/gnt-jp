{
 "lemma": "ἡμέρα",
 "lemmaId": "grc:G2250",
 "strong": "G2250",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "日（暦日・日数）",
   "def": "暦の一日と、その数。夜を含む24時間の単位。",
   "note": "MAT 6:34、MAT 12:40（三日三晩）、MAT 4:2（四十日）。"
  },
  {
   "id": "2",
   "label": "時代・時期",
   "def": "「〜の時代」「そのころの時期」を表す日々。人の治世や生涯の期間にも用いる。",
   "note": "MAT 2:1（ヘロデの時代）、MAT 3:1（そのころ）、ACT 15:7（初めのころ）。"
  },
  {
   "id": "3",
   "label": "終末の日",
   "def": "神の裁きと救いが現れる「その日」。主の日、裁きの日、キリストの日。人の裁きの座を指す場合も含む。",
   "note": "MAT 7:22、MAT 10:15（裁きの日）、1TH 5:2（主の日）、1CO 4:3（人の日＝人の裁き）。"
  },
  {
   "id": "4",
   "label": "定まった日",
   "def": "祭り、安息日、主の日、八日目など、暦や慣習の上で定まった特定の日。",
   "note": "MRK 14:12（種なしパンの日）、LUK 4:16（安息日）、REV 1:10（主の日）、ACT 2:1（五旬節の日）。"
  },
  {
   "id": "5",
   "label": "日々（毎日）",
   "def": "毎日、日に日に、という繰り返し・継続。",
   "note": "MAT 26:55・LUK 9:23（毎日）、MRK 5:5（夜も昼も絶えず）。"
  },
  {
   "id": "6",
   "label": "昼間",
   "def": "夜に対する昼の時間。日の出ている間。",
   "note": "JHN 11:9（昼の時間）、LUK 4:42（日が昇って）。"
  },
  {
   "id": "7",
   "label": "年齢（歳月）",
   "def": "年老いたことを「日々に進んでいる」と表す場合の歳月。",
   "note": "LUK 1:7・1:18・2:36（いずれも高齢の表現）。"
  }
 ],
 "idioms": [
