{
 "lemma": "ὡς",
 "lemmaId": "grc:G5613",
 "strong": "G5613",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "〜のように・〜として",
   "label_en": "as / like",
   "label_es": "como",
   "def": "様態や比較を表す。「〜のように」「〜の通りに」、また資格や身分を表して「〜として」。推量（〜のように見える）も含む。",
   "note": "MAT 5:48、MAT 6:10、TIT 1:7（神の家令として）、1PE 4:16（クリスチャンとして）。"
  },
  {
   "id": "2",
   "label": "〜のとき・〜の間",
   "label_en": "when / while",
   "label_es": "cuando / mientras",
   "def": "時間を表す接続詞。「〜したとき」「〜している間」「〜以来」。",
   "note": "LUK 1:41、LUK 24:32（話しておられる間）、GAL 6:10（機会のある間）、MRK 9:21（いつ以来）。"
  },
  {
   "id": "3",
   "label": "およそ〜",
   "label_en": "about / approximately",
   "label_es": "cerca de / aproximadamente",
   "def": "数や量の近似。「およそ〜ほど」。",
   "note": "MRK 5:13、ACT 1:15、LUK 1:56。"
  },
  {
   "id": "4",
   "label": "どのように・〜こと",
   "label_en": "how / that",
   "label_es": "cómo / que",
   "def": "間接疑問や内容を導く。「どのように〜か」「〜ということを」。",
   "note": "MRK 4:27、LUK 8:47、ACT 17:22、1TH 2:10（あなたがたは証人＝どのように振る舞ったか）。"
  },
  {
   "id": "5",
   "label": "なんと〜",
   "label_en": "how …!",
   "label_es": "¡cuán …!",
   "def": "感嘆。「なんと〜なことか」。",
   "note": "ROM 10:15、ROM 11:33。"
  },
  {
   "id": "6",
   "label": "〜するように（目的）",
   "label_en": "so that (purpose)",
   "label_es": "para que (propósito)",
   "def": "目的や目指す結果を表す。「〜するために」。",
   "note": "ACT 20:24、LUK 9:52（用意するために）。"
  },
  {
   "id": "7",
   "label": "〜ので（理由）",
   "label_en": "because (reason)",
   "label_es": "porque (razón)",
   "def": "理由や根拠を表す。",
   "note": "ACT 22:11（目が見えなかったので）、2PE 1:3。"
  }
 ],
 "idioms": [
  {
   "form": "ὡς τάχιστα",
   "gloss": "できるだけ早く",
   "refs": [
    "ACT 17:15"
   ]
  },
  {
   "form": "ὡς ἔπος εἰπεῖν",
   "gloss": "いわば・言ってみれば",
   "refs": [
    "HEB 7:9"
   ]
  }
 ],
