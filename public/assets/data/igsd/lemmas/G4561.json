  },
  {
   "id": "4",
   "label": "血縁・出自",
   "label_en": "kinship / descent",
   "label_es": "parentesco / linaje",
   "def": "生まれによる結びつき。血統、同胞、自然の出自による関係。",
   "note": "ln 58.1 + 10.1 + JHN 1:13（25.29）+ HEB 12:9"
  },
  {
   "id": "5",
   "label": "人間的な基準・領域",
   "label_en": "human standard / sphere",
   "label_es": "criterio / ámbito humano",
   "def": "神によらない人間の基準や立場。「肉に従って」判断する・誇る・頼る、の領域。",
   "note": "ln 9.12 + 26.7 の該当分（JHN 8:15, 1CO 1:26, 2CO 1:17, 5:16, 10:2/3, 11:18, GAL 6:12, PHM 1:16）"
  },
  {
   "id": "6",
   "label": "人間の弱さ",
   "label_en": "human weakness",
   "label_es": "debilidad humana",
   "def": "意欲に反して弱い、人間の有限さ・弱さ。",
   "note": "26.7 のうち MAT 26:41 / MRK 14:38 / ROM 6:19"
  },
  {
   "id": "7",
   "label": "肉（罪の原理）",
