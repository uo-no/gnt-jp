{
 "lemma": "ἐπί",
 "lemmaId": "grc:G1909",
 "strong": "G1909",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "〜の上に（場所）",
   "label_en": "on (place)",
   "def": "物の上やそばに位置すること。座る・立つ・書かれている状態も含む。 ἐπὶ τὸ αὐτό で「一緒に・一か所に」。",
   "note": "MAT 6:19（地に宝を）、MAT 9:9（徴税所に座って）、ACT 2:1（一か所に集まって）。"
  },
  {
   "id": "2",
   "label": "〜の上へ・〜へ（方向）",
   "label_en": "onto / to (direction)",
   "def": "上へ向かう移動や近づく方向。手で触れる・首に抱きつく・書き込むことも含む。",
   "note": "MAT 24:16（山へ逃げよ）、REV 16:12（川に注いだ）、1PE 2:25（羊飼いのもとへ戻った）、LUK 15:20（首に抱きついた）。"
  },
  {
   "id": "3",
   "label": "〜の上に臨む（及ぶ）",
   "label_en": "to come upon (rest on)",
   "def": "祝福・御霊・御国・怒り・裁き・災いが人の上に及ぶこと。その名が上に呼ばれることも含む。",
   "note": "MAT 10:13（平和が臨む）、MAT 12:28（御国が臨んだ）、ACT 19:6（聖霊が臨んだ）、MAT 27:25（その血は私たちの上に）。"
  },
  {
   "id": "4",
   "label": "〜に対して（敵対）",
   "label_en": "against (hostility)",
   "def": "敵意を持って向かうこと。王が王に敵対する、手をかけて捕らえる、も含む。",
   "note": "MAT 10:21、MAT 24:7、LUK 20:19（手をかけようとした）。"
  },
  {
   "id": "5",
   "label": "〜を治める（権威）",
   "label_en": "over (authority)",
   "def": "人や物を支配する立場。「〜の上に立つ者」。",
   "note": "MAT 24:47（全財産の上に）、MAT 25:21（多くのものの上に）、REV 2:26（諸国を治める権威）。"
  },
  {
   "id": "6",
   "label": "〜の時に・〜の間（時）",
   "label_en": "at / during (time)",
   "def": "「〜（の時代）の時に」と、期間の長さ。「三年の間」「長く」のように続く間。",
   "note": "LUK 3:2（大祭司の時に）、LUK 4:25（三年六か月の間）、MRK 2:26（アビアタルが大祭司の時）。"
  },
  {
   "id": "7",
   "label": "〜の前で（臨席）",
   "label_en": "before (in the presence of)",
   "def": "総督・王・裁判の前に立つこと。証言や告白の場。",
   "note": "MAT 10:18（総督や王の前に）、MRK 13:9、1TI 6:13（ポンテオ・ピラトの前で告白した）。"
  },
  {
   "id": "8",
   "label": "〜に基づいて・〜のゆえに（根拠・目的）",
   "label_en": "on the basis of / because of (ground / purpose)",
   "def": "行いや感情の土台・理由・目的。「〜に驚く」「〜を喜ぶ」の対象、名によって、言葉によって、希望を置く先、真実に（ ἐπ᾽ ἀληθείας ）も含む。",
   "note": "MAT 7:28（教えに驚いた）、MAT 4:4（言葉によって生きる）、ROM 4:18（希望にもとづいて信じた）、MAT 18:5（私の名によって受け入れる）。"
  },
  {
   "id": "9",
   "label": "〜に加えて（付加）",
   "label_en": "in addition to",
   "def": "既にあるものへの上乗せ。",
   "note": "LUK 3:20（これらすべての上に加えて）、LUK 12:25（身長に加える）、2CO 7:13（それに加えて）。"
  },
  {
   "id": "10",
   "label": "〜について（話題）",
   "label_en": "about (topic)",
   "def": "書物の記事・預言・証言が向けられる事柄。",
   "note": "MRK 12:26（藪の記事について）、REV 10:11（諸民族について預言する）、1TI 1:18（あなたについての預言）。"
  }
 ],
