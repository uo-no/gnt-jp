{
 "lemma": "ἀκούω",
 "lemmaId": "grc:G191",
 "strong": "G191",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "聞く（耳にする）",
   "label_en": "to hear (listen)",
   "def": "音・声・言葉が耳に入ること。耳が聞こえるようになることも含む。",
   "note": "MAT 8:10、MAT 11:5（耳の聞こえない人が聞こえる）、JHN 5:28（死者が御声を聞く）。"
  },
  {
   "id": "2",
   "label": "知らせを聞く",
   "label_en": "to hear news",
   "def": "出来事や人のことを知らせとして聞き知ること。",
   "note": "MAT 2:3（ヘロデが聞いた）、MAT 4:12（ヨハネが捕らえられたと聞いて）。"
  },
  {
   "id": "3",
   "label": "聞き従う・聞き入れる",
   "label_en": "to obey / heed",
   "def": "注意して聞き、受け入れて従うこと。「聞け」という呼びかけも含む。",
   "note": "MAT 7:24（聞いて行う）、MRK 9:7・MAT 17:5（彼に聞け）、HEB 3:7（今日、御声を聞くなら）。"
  },
  {
   "id": "4",
   "label": "聞いて悟る",
   "label_en": "to hear and understand",
   "def": "聞いた内容を理解すること。聞いても悟らない、という否定的な文脈で多く現れる。",
   "note": "MAT 13:13・13:15、ACT 28:27（耳で聞いても悟らない）、JHN 6:60（聞き難い言葉）。"
  },
  {
   "id": "5",
   "label": "聞き届ける（神が）",
   "label_en": "to hear (God answering)",
   "def": "神が祈りや願いを聞き届けること。",
   "note": "JHN 9:31、1JN 5:14・5:15。"
  },
  {
   "id": "6",
   "label": "聴取する",
   "label_en": "to hear (a case)",
   "def": "裁判や公式の場で、本人の言い分を聞くこと。",
   "note": "JHN 7:51、ACT 24:4、ACT 25:22。"
  }
 ],
 "idioms": [
  {
   "form": "ὁ ἔχων ὦτα ἀκούειν ἀκουσάτω",
   "gloss": "聞く耳のある者は聞きなさい",
   "refs": [
    "MAT 11:15",
    "MRK 4:23",
    "REV 2:7"
   ]
  },
  {
   "form": "ἀκοῇ ἀκούσετε",
   "gloss": "聞きに聞く（が悟らない）",
   "refs": [
    "MAT 13:14",
    "ACT 28:26"
   ]
  }
 ],
