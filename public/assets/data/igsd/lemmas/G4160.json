{
 "lemma": "ποιέω",
 "lemmaId": "grc:G4160",
 "strong": "G4160",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "行う",
   "label_en": "to do",
   "def": "行い全般。命じられたこと・善いこと・悪いことを行う。神の御心を行う、御言葉を行うなど。",
   "note": "MAT 5:19、MAT 7:12、ACT 9:36（善い行い）、1CO 11:25（これを行いなさい）。"
  },
  {
   "id": "2",
   "label": "作る・造る",
   "label_en": "to make",
   "def": "物を形作る、建てる、備えること。神の創造も含む。",
   "note": "MAT 19:4（造った方）、MAT 17:4（小屋を造る）、ACT 4:24（天と地を造った方）、JHN 14:23（住まいを設ける）。"
  },
  {
   "id": "3",
   "label": "〜にする・任じる",
   "label_en": "to make / appoint",
   "def": "ある人をある状態や役目にすること。任命すること。",
   "note": "MAT 4:19（人間をとる漁師にする）、MAT 5:32、MRK 3:14（十二人を任じる）、ACT 2:36（主とし、キリストとした）。"
  },
  {
   "id": "4",
   "label": "実を結ぶ・生む",
   "label_en": "to bear fruit / produce",
   "def": "木が実を結ぶこと。比喩で、実や利益を生み出すこと。",
   "note": "MAT 3:8・3:10、MAT 7:17、LUK 19:18（ミナが五ミナを生んだ）。"
  },
  {
   "id": "5",
   "label": "時を過ごす",
   "label_en": "to spend (time)",
   "def": "期間を過ごすこと（JAS 4:13 のみ）。",
   "note": "JAS 4:13（一年を過ごす）。"
  }
 ],
 "idioms": [
  {
   "form": "πορείαν ποιεῖσθαι",
   "gloss": "旅をする",
   "refs": [
    "LUK 13:22"
   ]
  },
  {
   "form": "σπουδὴν ποιεῖσθαι",
   "gloss": "熱心に努める",
   "refs": [
    "JUD 1:3"
   ]
  },
  {
   "form": "τὸ ἱκανὸν ποιεῖν",
   "gloss": "（群衆を）満足させる",
   "refs": [
    "MRK 15:15"
   ]
  },
  {
   "form": "σημεῖα ποιεῖν",
   "gloss": "しるしを行う",
   "refs": [
    "JHN 2:23"
   ]
  }
 ],
