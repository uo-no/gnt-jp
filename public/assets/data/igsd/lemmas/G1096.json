{
 "lemma": "γίνομαι",
 "lemmaId": "grc:G1096",
 "strong": "G1096",
 "status": "final",
 "updated": "2026-11-10",
 "senses": [
  {
   "id": "1",
   "label": "起こる・生じる（出来事）",
   "def": "出来事・現象・状況が発生したり成就したりすること。歴史的出来事・奇跡・苦難・預言の成就など様々な事象に広く用いられ、「〜が起きた」という意味の最多用法。",
   "note": "マタ1:22、マタ5:18、マタ8:24、使8:8。καὶ ἐγένετο / ἐγένετο δέ もここ。"
  },
  {
   "id": "2",
   "label": "〜になる・〜となる（変化・転換）",
   "def": "人・物・状況が新たな性質・状態・役割に移ること。述語補語・εἰς句・ὡς句を伴い、「〜に成る」という状態変化を表す。",
   "note": "マタ4:3、ヨハ2:9、コリ一13:11、マコ12:10（εἰς κεφαλὴν γωνίας）。"
  },
  {
   "id": "3",
   "label": "生まれる・作られる・現れる（誕生・創造・出現）",
   "def": "人・物・声が存在に入ること、または初めて現れること。神による創造・誕生・公的な登場・声が生じることを含む。",
   "note": "ヨハ1:3、ヨハ1:6、マコ2:27、ルカ3:22。"
  },
  {
   "id": "4",
   "label": "いる・ある・来る（所在・到着）",
   "def": "人・集団・出来事がある場所または状況に位置すること、またはそこに到達すること。ἐν + 場所や εἰς + 場所を伴うことが多い。",
   "note": "マタ26:6、マコ4:10、マコ1:4、ルカ2:13。"
  },
  {
   "id": "5",
   "label": "〜のものになる・〜に属する（所有・帰属）",
   "def": "人が婚姻・法的関係によって誰かの所属下に入ること、または物が誰かの所有になること。γίνομαι + 与格の形で現れる。",
   "note": "ロマ7:3（×2）、ロマ7:4（婚姻・法的所属）。マタ18:12「百匹の羊を持つ（γένηταί τινι）」（所有）。"
  }
 ],
 "idioms": [
  {
   "form": "μὴ γένοιτο",
   "gloss": "「絶対にそんなことはない」。強い否定・拒絶を表す固定的感嘆表現。パウロ書簡に多出",
   "refs": [
    "ROM 3:4",
    "ROM 3:6",
    "ROM 6:2",
    "ROM 7:7",
    "ROM 9:14",
    "1CO 6:15",
    "GAL 2:17"
   ]
  },
  {
   "form": "καὶ ἐγένετο / ἐγένετο δέ",
   "gloss": "「〜の時に〜があった」。LXX由来のヘブライ的文体で時間・場面転換を導く定型表現。ルカ文書に集中",
   "refs": [
    "LUK 1:8",
    "LUK 2:1",
    "LUK 8:1",
    "ACT 5:7",
    "ACT 10:25"
   ]
  },
  {
   "form": "γνώμης γίνομαι",
   "gloss": "「決意する・決める」。γίνομαι + 属格で意図を持つことを表す",
   "refs": [
    "ACT 20:3"
   ]
  }
 ],
