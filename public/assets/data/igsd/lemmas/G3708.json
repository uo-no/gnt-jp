{
 "lemma": "ὁράω",
 "lemmaId": "grc:G3708",
 "strong": "G3708",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "目で見る",
   "def": "目で見て認めること。幻や現れを見ることも含む。神やキリストをこの目で見る場合もここに置く。",
   "note": "MAT 2:2（星を）、MRK 1:10（天が開けるのを）、JHN 14:9（私を見た者は父を見た）。"
  },
  {
   "id": "2",
   "label": "見て取る・知る",
   "def": "心で悟り、気づき、知ること。 εἰδώς（知って）の形も含む。",
   "note": "MAT 9:4（思いを知って）、MRK 12:28（見事に答えたのを見て取って）、ACT 8:23（見て取る）。"
  },
  {
   "id": "3",
   "label": "気をつける",
   "def": "「見よ、気をつけよ」という注意・配慮。悪いことがないように見張ること。",
   "note": "MAT 8:4、MAT 16:6、MAT 27:4（あなたがたの知ったこと＝自分で始末せよ）、1TH 5:15。"
  },
  {
   "id": "4",
   "label": "経験する（〜を見る）",
   "def": "死・朽ち果て・命・幸いな日々などを「見る」と言う、経験の言い方。",
   "note": "LUK 2:26（死を見ない）、JHN 3:36（命を見ない）、ACT 2:27（朽ち果てを見ない）、1PE 3:10（幸いな日々を見る）。"
  },
  {
   "id": "5",
   "label": "会う・訪ねる",
   "def": "人に会いに行く、訪問すること。",
   "note": "LUK 8:20（お目にかかりたい）、JHN 12:21、ROM 1:11（あなたがたに会いたい）。"
  }
 ],
 "idioms": [
  {
   "form": "ὅρα μή",
   "gloss": "気をつけよ（〜するな）",
   "refs": [
    "MAT 8:4",
