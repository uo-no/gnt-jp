{
 "lemma": "δίδωμι",
 "lemmaId": "grc:G1325",
 "strong": "G1325",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "与える（渡す）",
   "label_en": "to give (hand over)",
   "def": "物や人を相手に手渡すこと。求めに応じて渡す、差し出す。",
   "note": "MAT 5:42、MAT 7:9（石ではなくパン）、LUK 14:9（席を譲る）。"
  },
  {
   "id": "2",
   "label": "授ける",
   "label_en": "to grant",
   "def": "神や権威ある者が、権威・恵み・賜物・機会・命などを授けること。",
   "note": "MAT 28:18（権威）、JHN 1:12（子となる特権）、JAS 4:6（恵み）、LUK 12:32（御国）。"
  },
  {
   "id": "3",
   "label": "支払う・預ける",
   "label_en": "to pay / entrust",
   "def": "賃金・税・代価として渡すこと。銀行に預けることも含む。",
   "note": "MAT 20:4（賃金）、MAT 17:27（納入金）、MAT 16:26（代償）、LUK 19:23（預金）。"
  },
  {
   "id": "4",
   "label": "ささげる",
   "label_en": "to offer",
   "def": "自分の命や自分自身を差し出すこと。",
   "note": "MAT 20:28・MRK 10:45（贖いの代価として命を）、GAL 1:4、2CO 8:5（自分自身を主に）。"
  },
  {
   "id": "5",
   "label": "置く・入れる",
   "label_en": "to put / place",
   "def": "物をある場所に置く、心の中に入れること。指輪をはめる、律法を思いに置く、扉を設けるなど。",
   "note": "LUK 15:22（指輪）、HEB 8:10（律法を思いに）、REV 3:8（開かれた扉）。"
  },
  {
   "id": "6",
   "label": "現す・出す",
   "label_en": "to produce / give out",
   "def": "光・音・しるし・雨などを生み出すこと。死者を出す、実を結ぶことも含む。",
   "note": "MAT 24:29（月は光を放たない）、MAT 24:24（しるしを行う）、1CO 14:7（音を出す）、MRK 4:8（実を結ぶ）、REV 20:13（死者を出す）。"
  },
  {
   "id": "7",
   "label": "行為として与える",
   "label_en": "to give as an act",
   "def": "接吻・平手打ち・答え・弁明・栄光など、行為そのものを相手に向ける言い方。",
   "note": "LUK 7:45（接吻）、JHN 18:22（平手打ち）、JHN 19:9（答え）、ROM 14:12（弁明）、LUK 17:18（栄光を帰す）。"
  }
 ],
 "idioms": [
  {
   "form": "δεξιὰς διδόναι",
   "gloss": "協力の握手を交わす",
   "refs": [
    "GAL 2:9"
   ]
  },
  {
   "form": "δὸς δόξαν τῷ θεῷ",
   "gloss": "神に栄光を帰せよ（＝正直に告白せよ）",
   "refs": [
    "JHN 9:24"
   ]
  },
  {
   "form": "ἐργασίαν διδόναι",
   "gloss": "努力する・手を尽くす",
   "refs": [
    "LUK 12:58"
   ]
  },
  {
   "form": "συμβούλιον διδόναι",
   "gloss": "相談する・謀る",
   "refs": [
    "MRK 3:6"
   ]
  }
 ],
