{
 "lemma": "εἰ",
 "lemmaId": "grc:G1487",
 "strong": "G1487",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "もし〜なら",
   "def": "条件を導く。「もし〜なら」。論証の中では「〜である以上」の含みを持つこともある。",
   "note": "MAT 4:3、MAT 5:29、MAT 6:30（まして）、1TH 4:14。"
  },
  {
   "id": "2",
   "label": "〜でなければ（例外）",
   "def": "εἰ μή の形で例外を表す。「〜でなければ」「〜以外には」。",
   "note": "MAT 11:27、MAT 5:13、MAT 12:4（祭司でなければ）。"
  },
  {
   "id": "3",
   "label": "〜かどうか",
   "def": "間接疑問を導く。「〜かどうか」。",
   "note": "MAT 26:63、MAT 27:49（来るかどうか見よう）、MAT 12:10。"
  },
  {
   "id": "4",
   "label": "たとえ〜でも",
   "def": "εἰ καί の形で譲歩を表す。「たとえ〜であっても」。",
   "note": "MRK 14:29、2CO 4:3 他。"
  },
  {
   "id": "5",
   "label": "確かに（誓い）",
   "def": "ヘブライ語法の誓いの言い方（ εἰ μήν ）。HEB 6:14 のみ。「必ず〜する」。",
   "note": "HEB 6:14。"
  }
 ],
 "idioms": [
  {
   "form": "εἰ μή",
   "gloss": "〜でなければ・〜以外は",
   "refs": [
