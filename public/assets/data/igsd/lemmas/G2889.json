{
 "lemma": "κόσμος",
 "lemmaId": "grc:G2889",
 "strong": "G2889",
 "status": "final",
 "updated": "2026-11-10",
 "senses": [
  {
   "id": "1",
   "label": "宇宙・被造世界（創成から）",
   "label_en": "universe / creation (from the beginning)",
   "def": "天地創造以来存在してきた被造物の全体としての宇宙。「世界の基が据えられた時から」という時間的・宇宙論的表現に特化して現れ、物理的地上よりも広い概念を指す。",
   "note": "καταβολή κόσμου 定型表現：マタ25:34, ルカ11:50, ヘブ4:3, ヘブ9:26。マタ24:21「世界の始まりから今まで」も同系。"
  },
  {
   "id": "2",
   "label": "世界（地上・物的現実）",
   "label_en": "world (earth / material reality)",
   "def": "人間が生きる地上の空間、またはそこにある物質的なものの総体。「世界を手に入れる」「世界のものを使う」という文脈での物的現実を指す。",
   "note": "マタ4:8「世界のすべての王国」、マタ16:26「全世界を手に入れても」、コリ一7:31、コロ2:20、テモ一6:7。"
  },
  {
   "id": "3",
   "label": "世の人々（人類）",
   "label_en": "the people of the world (humankind)",
   "def": "地上に生きる人間たちの総体。福音の対象・救いの射程として、また神の行為を受ける存在としての人類を指す。",
   "note": "マタ5:14「あなたがたは世界の光」、マコ14:9、ヨハ4:42「世界の救い主」、ロマ3:6、コリ二5:19。"
  },
  {
   "id": "4",
   "label": "世（神に敵対する秩序）",
   "label_en": "world (order opposed to God)",
   "def": "神・キリスト・弟子たちと対立する支配原理または領域としての世界。神への服従を拒む人間社会の在り方を総体として指す。",
   "note": "ヨハ7:7、ヨハ8:23、ヨハ14:17、コリ一1:21、ヤコ1:27、ヨハ一4:4、エフェ2:2、ヨハ一2:15-17。"
  },
  {
   "id": "5",
   "label": "飾り・装飾",
   "label_en": "adornment / decoration",
   "def": "身を飾るもの。宝飾品や衣服など外面的な装飾品を指す。",
   "note": "ペテ一3:3の1箇所のみ。"
  }
 ],
