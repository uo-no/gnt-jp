{
 "lemma": "πρός",
 "lemmaId": "grc:G4314",
 "strong": "G4314",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "〜の方へ（方向）",
   "label_en": "toward (direction)",
   "label_es": "hacia (dirección)",
   "def": "人や場所への移動・方向。夕方に近づく、石に打ちつける、なども含む。主に対格を伴う。",
   "note": "MAT 3:5、MRK 6:51、LUK 24:29（夕方に近づいた）、MAT 4:6（足を石に打ちつける）。"
  },
  {
   "id": "2",
   "label": "〜に対して（対話・関わり）",
   "label_en": "to / with (dialogue / relation)",
   "label_es": "a / con (diálogo / relación)",
   "def": "言葉や態度の向けられる相手。「〜に向かって言った」、互いの話し合い、敵対や親しみも含む。",
   "note": "LUK 7:40（彼に言った）、MRK 9:10（互いに議論した）、EPH 6:12（相手は〜ではなく）、LUK 23:12（互いに親しくなった）。"
  },
  {
   "id": "3",
   "label": "〜するために（目的）",
   "label_en": "in order that (purpose)",
   "label_es": "para que (propósito)",
   "def": "目的や帰結を表す。特に πρὸς τό ＋不定詞（〜するために）。益になる対象も含む。",
   "note": "MAT 5:28、MAT 6:1（見せるために）、LUK 18:1（祈るべきことを）、1TI 4:8（益になる）。"
  },
  {
   "id": "4",
   "label": "〜のところに・〜のそばに（存在・近接）",
   "label_en": "at / near (presence / proximity)",
   "label_es": "junto a / cerca de (presencia / proximidad)",
   "def": "そばにいる・あること。人のもとにいる、戸口や根もとにある。",
   "note": "MRK 1:33（戸口のところに）、MAT 3:10（根もとに）、MRK 6:3（私たちと一緒にいる）、JHN 1:1（神と共にいた）。"
  },
  {
   "id": "5",
   "label": "短い間（期間）",
   "label_en": "for a short time (duration)",
   "label_es": "por poco tiempo (duración)",
   "def": "πρὸς καιρόν／ὥραν／ὀλίγον で、短い期間。",
   "note": "LUK 8:13（しばらくの間）、JHN 5:35、JAS 4:14（しばらく現れる）。"
  },
  {
   "id": "6",
   "label": "〜に関して・〜に応じて",
   "label_en": "regarding / according to",
   "label_es": "respecto a / según",
   "def": "関係や基準。「〜に関して」「〜に照らして」。へブル書の「〜について言った」の定型も含む。",
   "note": "MAT 27:4（私たちに何の関係が）、MAT 19:8（あなたがたの頑なさに照らして）、HEB 1:7、LUK 12:47（意志に沿って）。"
  }
 ],
 "idioms": [
  {
   "form": "πρὸς τό + 不定詞",
   "gloss": "〜するために",
   "refs": [
    "MAT 5:28",
    "EPH 6:11"
   ]
  },
  {
   "form": "πρὸς καιρόν",
   "gloss": "しばらくの間",
