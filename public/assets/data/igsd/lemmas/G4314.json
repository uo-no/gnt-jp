    "1CO 7:5"
   ]
  },
  {
   "form": "τί πρὸς ἡμᾶς（σέ）",
   "gloss": "私たち（あなた）に何の関係があるか",
   "refs": [
    "MAT 27:4",
    "JHN 21:22"
   ]
  }
 ],
