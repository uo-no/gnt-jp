{
 "lemma": "χάρις",
 "lemmaId": "grc:G5485",
 "strong": "G5485",
 "status": "final",
 "updated": "2026-11-10",
 "senses": [
  {
   "id": "1",
   "label": "恵み（神の救済的・変革的恵み）",
   "label_en": "grace (God's saving and transforming grace)",
   "def": "人の功績によらず神が一方的に与える救済の恵み。キリストの贖いの御業を通して流れ出る神の変革的な働きを指し、救済の根拠・動力として新約神学の中心を占める。",
   "note": "ロマ11:6「行いによれば恵みでなくなる」（ἔργα と対比）、ロマ4:4（ὀφείλημα と対比）、エフェ2:5, 8「恵みによって救われた」、ロマ5:15「恵みの賜物は一人の違反と比べものにならない」が核心。χάρις ὑμῖν καὶ εἰρήνη（パウロ書簡冒頭定式）もここ。"
  },
  {
   "id": "2",
   "label": "好意・恩顧",
   "label_en": "favor",
   "def": "特定の人物や集団に向けられた好意・庇護的配慮。人間関係の恩顧（政治的配慮・社会的厚意）にも、神が特定の人物に示す格別の配慮にも用いられ、旧約の「目に恵みを見出す」（חֵן）用法を引き継ぐ。",
   "note": "ルカ2:52「神と人との前で恵みにおいて成長した」、使7:10「ヨセフにファラオの前で恵みを与えた」、使24:27「ユダヤ人の歓心を買おうとして」、使25:3「好意として要求した」が典型。"
  },
  {
   "id": "3",
   "label": "感謝・謝意",
   "label_en": "thanks / gratitude",
   "def": "受けた恵みや好意に対する感謝の気持ちまたはその表明。χάριν ἔχω（感謝する）という定型表現の形で多く現れる。",
   "note": "ルカ17:9「奴隷に感謝するだろうか」、ロマ6:17「神に感謝」、ロマ7:25「神に感謝」、テモ一1:12「強くしてくださったキリストに感謝する」、ヘブ12:28「感謝をもって神に喜ばれる礼拝を」。"
  },
  {
   "id": "4",
   "label": "優雅さ・品格（言葉の）",
   "label_en": "grace / charm (of speech)",
   "def": "言葉や語り口の優雅さ・魅力的な質。聞く者を引きつける言葉の品格を指す。",
   "note": "ルカ4:22「彼の口から出る恵みの言葉（λόγοι τῆς χάριτος）に驚いた」、コロ4:6「あなたがたの言葉はいつも優雅で（ἐν χάριτι）」。出現数は少なく限定的。"
  }
 ],
