{
 "lemma": "διά",
 "lemmaId": "grc:G1223",
 "strong": "G1223",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "経由・仲介",
   "def": "人（神・キリスト・預言者・使者など）を経由して、あるいはその人を通して事が行われる関係。属格を取る。",
   "note": "MAT 1:22（主が預言者を通して語る）、JHN 1:17（モーセを通して律法）、ROM 11:36（万物は彼を通して）。"
  },
  {
   "id": "2",
   "label": "手段・方法",
   "def": "物・言葉・出来事などを手段として事が行われる関係。「〜によって」。属格を取る。",
   "note": "LUK 8:4（たとえによって）、ACT 5:12（手々を通して＝手によって）、ROM 3:30（信仰によって）、HEB 9:12（自分の血によって）。手紙の「〜を通して書く」（1PE 5:12）もここ。"
  },
  {
   "id": "3",
   "label": "空間",
   "def": "場所を通り抜ける、あるいは広がる関係。「〜を通って」。属格を取る（LUK 17:11 のみ対格）。",
   "note": "MAT 7:13（狭い門を通って）、LUK 4:30（中を通って）、HEB 11:29（紅海を通る）。"
  },
  {
   "id": "4",
   "label": "期間・継続",
   "def": "時間の広がりの中で事が続く関係。「〜の間」「〜を通して」「夜に」「いつも」。属格を取る。",
   "note": "LUK 5:5（一晩中）、ACT 1:3（40日の間）、MAT 18:10（διὰ παντός＝いつも）。"
  },
  {
   "id": "5",
   "label": "間隔・経過",
   "def": "ある期間が過ぎた後の時点を示す関係。「〜の後に」。属格を取る。3件のみ。",
   "note": "GAL 2:1（14年の後に）、ACT 24:17、MRK 2:1。"
  },
  {
   "id": "6",
   "label": "原因・理由",
   "def": "出来事や感情・事情が原因となって事が起こる関係。「〜のために（原因）」「〜のゆえに」。対格を取る。",
   "note": "MAT 27:18（ねたみのために）、JHN 7:13（恐れのために）。διὰ τοῦτο「それゆえ」、διὰ τί「なぜ」もここ。"
  },
  {
   "id": "7",
   "label": "目的・受益",
   "def": "誰かの益や目的のために事が行われる関係。「〜のためを思って」。対格を取る。",
   "note": "MRK 2:27（安息日は人のために）、JHN 11:42（群衆のために）、2CO 8:9（あなたがたのために貧しくなった）。"
  },
  {
   "id": "8",
   "label": "状態・様態",
   "def": "ある状態や境遇の中で事が行われる関係。「〜の状態で」「〜を伴って」。属格を取る。",
   "note": "ROM 4:11（割礼を受けていない状態で信じた者）、ROM 8:25（忍耐をもって＝忍耐のうちに）、2CO 2:4（多くの涙とともに）、2CO 5:7（信仰によって歩む）。"
  }
 ],
 "idioms": [
