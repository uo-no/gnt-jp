{
 "lemma": "κύριος",
 "lemmaId": "grc:G2962",
 "strong": "G2962",
 "status": "final",
 "updated": "2026-11-10",
 "senses": [
  {
   "id": "1",
   "label": "主・主なる神（神への称号）",
   "label_en": "Lord / the Lord God (title for God)",
   "def": "旧約の יהוה を承けた神への称号、またはキリスト（特に復活後）への神的称号。文脈によって父なる神・主イエスの双方を指す。",
   "note": "ὁ κύριος ἡμῶν（コリ一1:2, テサ一3:11）、κύριος Ἰησοῦς（使1:21, コリ一11:23）、κύριος σαβαώθ（ロマ9:29）。神への適用：マタ5:33, マコ5:19, 使7:33, ヘブ8:2, ヤコ4:15。安息日の主（マタ12:8）もここ。"
  },
  {
   "id": "2",
   "label": "主人・所有者（人間関係）",
   "label_en": "master / owner (human relations)",
   "def": "奴隷・使用人・財産に対して権限を持つ人間の主人または所有者。",
   "note": "マタ10:24、マタ20:8（ぶどう園の主人）、エフェ6:5, 9、使16:16。"
  },
  {
   "id": "3",
   "label": "主様・旦那様（尊称）",
   "label_en": "sir / master (respectful address)",
   "def": "教師・裁判官・為政者・見知らぬ人に対して用いられる呼びかけの尊称。神学的な主権を必ずしも意味しない社会的礼儀表現。",
   "note": "マタ13:27、マタ27:63（祭司長がピラトに）、ヨハ4:11。"
  },
  {
   "id": "4",
   "label": "主権者・支配者（社会的地位）",
   "label_en": "ruler / sovereign (social status)",
   "def": "制度・社会的文脈において権威を持つ者の称号。皇帝・複数の「主たち」という多神論的文脈を含む。",
   "note": "使25:26（皇帝）、コリ一8:5（多くの主たち）、テモ一6:15。"
  }
 ],
 "idioms": [
  {
   "form": "κύριος κυρίων",
   "gloss": "「主の中の主」。最高の主権者を指す最上級的称号。黙示録的文脈でキリストに適用される",
   "refs": [
    "REV 17:14",
    "REV 19:16"
   ]
  },
  {
   "form": "ἐν κυρίῳ",
   "gloss": "「主にあって」。キリストとの結合関係を示すパウロ的定型表現",
   "refs": [
    "ROM 14:14",
    "PHP 4:1",
    "PHP 4:2",
    "PHP 4:4"
   ]
  }
 ],
