{
 "lemma": "πνεῦμα",
 "lemmaId": "grc:G4151",
 "strong": "G4151",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "聖霊",
   "label_en": "Holy Spirit",
   "label_es": "Espíritu Santo",
   "def": "神の霊、聖霊。その位格と働き（満たし、導き、証言、教会への語りかけ）を指す。黙示録の「七つの霊」も、神の霊の完全な働きとしてここに置く。",
   "note": "MAT 1:18、ACT 13:2、ROM 8:16、REV 2:7（御霊は言う）、REV 1:4（七つの霊）。"
  },
  {
   "id": "2",
   "label": "人の霊（心・命）",
   "label_en": "human spirit (heart / life)",
   "label_es": "espíritu humano (corazón / vida)",
   "def": "人の内面としての霊・心。肉や体と対比され、死に際して神にゆだねられる命の霊。",
   "note": "MAT 26:41（霊は望む）、MRK 2:8（心の中で知る）、ACT 7:59（私の霊を受け入れてください）、MAT 5:3（心の貧しい者）。"
  },
  {
   "id": "3",
   "label": "霊的存在",
   "label_en": "spiritual being",
   "label_es": "ser espiritual",
   "def": "天使や人の死後の霊など、霊としての存在そのもの。「神は霊である」という存在のあり方や、預言の背後にある霊も含む。",
   "note": "JHN 4:24、HEB 1:14（仕える霊＝天使）、LUK 24:37（幽霊）、1JN 4:1（霊どもを吟味する）。"
  },
  {
   "id": "4",
   "label": "悪霊",
   "label_en": "demon",
   "label_es": "demonio",
   "def": "汚れた霊・悪しき霊。人に宿って害を与え、追い出される存在。",
   "note": "MAT 10:1、MRK 1:23、ACT 16:16（占いの霊）、1TI 4:1（惑わす霊ども）。"
  },
  {
   "id": "5",
   "label": "気質・影響（〜の霊）",
   "label_en": "disposition / influence (spirit of …)",
   "label_es": "disposición / influencia (espíritu de …)",
   "def": "ある性質や影響力を「〜の霊」と呼ぶ用法。神から与えられる性質（知恵の霊、力の霊）も含む。",
   "note": "ROM 8:15（奴隷の霊／子の霊）、1CO 2:12（世の霊）、EPH 1:17（知恵の霊）、2TI 1:7（力の霊）。"
  },
  {
   "id": "6",
   "label": "風・息",
   "label_en": "wind / breath",
   "label_es": "viento / aliento",
   "def": "動く空気としての風と、命を与える息。",
   "note": "JHN 3:8（風は思いのままに吹く）、REV 11:11（命の息）、2TH 2:8（御口の息）。"
  }
 ],
 "idioms": [
  {
   "form": "πνεῦμα ζωῆς",
   "gloss": "命の息",
   "refs": [
    "REV 11:11"
   ]
  }
 ],
