{
 "lemma": "μή",
 "lemmaId": "grc:G3361",
 "strong": "G3361",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "〜ない（条件・叙述）",
   "label_en": "not (condition / statement)",
   "def": "条件や思いに伴う否定。分詞・不定詞・条件節・関係節の中で「〜でない」「〜しなければ」を表す、 μή の基本の働き。",
   "note": "JHN 3:18（信じない者は）、MAT 12:30（味方でない者は）、ROM 4:5（行いによらない者）、MAT 13:5（根がないので）。"
  },
  {
   "id": "2",
   "label": "〜するな・〜しませんように（禁止・願望）",
   "label_en": "do not / may … not (prohibition / wish)",
   "def": "命令形や接続法に伴う禁止と願望。「〜するな」「〜しないでほしい」。 μὴ γένοιτο は「決してそんなことがあってはならない」。",
   "note": "MAT 7:1（さばくな）、MAT 1:20（恐れるな）、MAT 6:19（積んではならない）、ROM 3:4（ μὴ γένοιτο ）。"
  },
  {
   "id": "3",
   "label": "まさか〜か（問い）",
   "label_en": "surely not? (question)",
   "def": "「まさか〜ではあるまいな」と、否定の答えを待つためらいの問い。 οὐ が続くと肯定を待つ問いになる。",
   "note": "LUK 22:35（不足したことがあったか）、JHN 4:29（この方がキリストでは）、ROM 10:18（聞かなかったはずはない）。"
  },
  {
   "id": "4",
   "label": "〜しないように（おそれ・目的）",
   "label_en": "lest / so that … not (fear / purpose)",
   "def": "恐れる・気をつける動詞に続く「〜するといけないから」と、 ἵνα に続く否定的な目的「〜しないように」。",
   "note": "MRK 13:5（惑わされないように気をつけよ）、MAT 7:1（さばかれないように）、HEB 4:1（取り残されることのないように恐れよう）、2CO 12:20（恐れている、〜ではと）。"
  },
  {
   "id": "5",
   "label": "決して〜ない（ οὐ μή ）",
   "label_en": "never (οὐ μή)",
   "def": " οὐ と重なった強い否定の一部。「絶対に〜ない」。",
   "note": "MAT 5:18、JHN 6:35（決して飢えない）、LUK 1:15（決して飲まない）。"
  }
 ],
 "idioms": [
  {
   "form": "μὴ γένοιτο",
   "gloss": "決してそんなことがあってはならない",
   "refs": [
