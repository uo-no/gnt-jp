{
 "lemma": "ὑπέρ",
 "lemmaId": "grc:G5228",
 "strong": "G5228",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "〜のために・〜に代わって（恩恵・代理）",
   "def": "ある行為がある人・事柄の益となり、またはその代わりをなすことを示す前置詞句として働く。祈り・奉仕・犠牲・代贖など主体が対象者のために行動する文脈で広く用いられる。",
   "note": "支配格：属格。マタ5:44、マコ14:24、ヨハ10:11、ロマ5:8。代替的用法（〜の代わりに）もここに含む（コリ一15:29, フィレ13等）。"
  },
  {
   "id": "2",
   "label": "〜について・〜に関して（主題・参照）",
   "def": "発話・思考・関心・祈りの向かう対象・主題を導く前置詞句として働く。「〜についてしゃべる・書く・訴える・望む」に相当する参照関係を表す。",
   "note": "支配格：属格。ヨハ1:30、ロマ9:27、コリ二1:7、コリ二12:8。"
  },
  {
   "id": "3",
   "label": "〜ゆえに・〜のために（原因・動機）",
   "def": "行為・経験の原因または動機となる事柄を導く前置詞句として働く。「〜のゆえに苦しむ・誇る・喜ぶ」という文脈で現れ、語義1（恩恵）とは主体の動機づけに焦点がある点で異なる。",
   "note": "支配格：属格。使5:41、使21:13、ロマ15:9。"
  },
  {
   "id": "4",
   "label": "〜よりも・〜を超えて（比較・程度）",
   "def": "ある基準・人物を超える度合い・程度の超過を示す前置詞句として働く。比較級的な「〜より」または量・強度における「〜を超えた」を表す。",
   "note": "支配格：対格。マタ10:37a/b、ルカ16:8、ヘブ4:12。"
  },
  {
   "id": "5",
   "label": "〜の上に・〜より上位に（位置・序列）",
   "def": "地位・権限・序列において上位にあることを示す前置詞句として働く。物理的な上方よりも権威・等級の高さの意味で用いられることが多い。",
   "note": "支配格：対格。マタ10:24a/b、ルカ6:40、エフェ1:22。"
  },
  {
   "id": "6",
   "label": "もっと・いっそう（副詞）",
   "def": "比較の対象を明示しない形で程度の超過を示す副詞として働く。語義4（比較・程度）の前置詞用法が名詞句を取らない形に相当する。",
   "note": "コリ二11:23「私はいっそう（ὕπερ ἐγώ）そうだ」の1箇所のみ。"
  }
 ],
