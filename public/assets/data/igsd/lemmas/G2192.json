{
 "lemma": "ἔχω",
 "lemmaId": "grc:G2192",
 "strong": "G2192",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "所有",
   "label_en": "possession",
   "label_es": "posesión",
   "def": "物・財産・権威・機会などを、自分のものとして持つ働き。",
   "note": "MAT 19:22（多くの財産）、JHN 10:16（ほかの羊）、REV 11:6（権威）。「持っていない」も多くはここ（MAT 13:12）。"
  },
  {
   "id": "2",
   "label": "保持・携帯",
   "label_en": "holding / carrying",
   "label_es": "tener / llevar",
   "def": "手に持つ、身につける、帯びる、（器などが）含む、捕らえて保持する働き。",
   "note": "REV 1:16（右の手に星）、MAT 3:4（衣服）、HEB 9:4（中に含む）、MAT 27:16（囚人を保持）。"
  },
  {
   "id": "3",
   "label": "関係・身体",
   "label_en": "relationship / bodily condition",
   "label_es": "relación / condición corporal",
   "def": "人を関係として持つ（父・妻・友・王など）、身体の部分を持つ、身ごもる、分かち前を持つ働き。",
   "note": "MAT 3:9（父アブラハム）、MAT 11:15（聞く耳）、MAT 1:23（身ごもる）、1CO 7:2（妻・夫）。"
  },
  {
   "id": "4",
   "label": "状態・性質",
   "label_en": "state / condition",
   "label_es": "estado / condición",
   "def": "信仰・愛・平和・必要などの抽象的なものや、病・霊の憑きなどの状態を、心身の在り方として帯びる働き。",
   "note": "MAT 3:14（χρείαν ἔχω＝必要がある）、JHN 13:35（愛を持つ）、MAT 11:18（悪霊を持つ＝取り憑かれている）、MAT 5:23（不満を持つ）。"
  },
  {
   "id": "5",
   "label": "保つ",
   "label_en": "to keep",
   "label_es": "mantener",
   "def": "言葉・教え・信仰などを、離さず持ち続ける働き。",
   "note": "1TI 3:9（信仰の秘義を保つ）、2TI 1:13（健全な言葉の模範を保て）、ROM 1:28（神を心に留める）、LUK 19:20（しまっておいた）。"
  },
  {
   "id": "6",
   "label": "みなす",
   "label_en": "to regard as",
   "label_es": "considerar como",
   "def": "人を〜とみなして持つ働き。ὡς・εἰς を伴う場合と、ἔχε με παρῃτημένον「勘弁してほしい」の形。",
   "note": "MAT 14:5（預言者とみなす）、PHM 1:17（仲間として受け入れる）、LUK 14:18（ἔχε με παρῃτημένον）。"
  },
  {
   "id": "7",
   "label": "能力・必然",
   "label_en": "ability / necessity",
   "label_es": "capacidad / necesidad",
   "def": "不定詞を伴い、「〜できる」「〜するものを持っている」「〜せざるを得ない」を表す働き。",
   "note": "MAT 18:25（返すものがない＝返せない）、LUK 12:50（受けねばならないバプテスマ）、JHN 8:26（語るべきことを多く持つ）、ACT 4:14（言い返せなかった）。"
  },
  {
   "id": "8",
   "label": "様態",
   "label_en": "manner",
   "label_es": "manera",
   "def": "καλῶς・κακῶς・οὕτως・ἑτοίμως などを伴い、「〜の状態にある」を表す自動詞的な働き。期間を表す場合も含む。",
   "note": "MAT 4:24（κακῶς ἔχοντες＝病人）、JHN 4:52（快方に向かった）、ACT 7:1（οὕτως ἔχει＝そのとおりか）、JHN 5:5（38年患っている）。"
  },
  {
   "id": "9",
   "label": "中態（次・付随）",
   "label_en": "middle voice (next / adjoining)",
   "label_es": "voz media (siguiente / contiguo)",
   "def": "ἔχομαι の形で、時・場所について「次である」、物事について「付随する」を表す働き。",
   "note": "LUK 13:33（翌日）、MRK 1:38（近隣の町々）、HEB 6:9（救いに付随すること）。"
  }
 ],
 "idioms": [
