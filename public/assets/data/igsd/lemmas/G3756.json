{
 "lemma": "οὐ",
 "lemmaId": "grc:G3756",
 "strong": "G3756",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "〜ない（否定）",
   "label_en": "not (negation)",
   "def": "事実を否定する基本の働き。動詞や語句を打ち消す。 οὐκ … ἀλλά で「〜ではなく…だ」の対比、 οὐκ ὀλίγοι のように二重の含みで「かなりの」を表すこともある（緩叙法）。未来形と結ぶと強い禁止にもなる。",
   "note": "MAT 1:25、ROM 1:16（恥としない）、ACT 17:4（少なくない＝かなりの人々）、MAT 4:7（試みてはならない＝二人称未来）。"
  },
  {
   "id": "2",
   "label": "決して〜ない（ οὐ μή ）",
   "label_en": "never (οὐ μή)",
   "def": " μή を重ねた強い否定。「絶対に〜ない」「決して〜ない」。",
   "note": "MAT 5:18（決して過ぎ去らない）、MAT 24:35（私の言葉は決して過ぎ去らない）、JHN 10:28（決して滅びない）。"
  },
  {
   "id": "3",
   "label": "〜ではないか（問い）",
   "label_en": "is it not? (question)",
   "def": "肯定の答えを待つ問い。「〜ではないか」「〜したではないか」。",
   "note": "MAT 6:26（あなたがたは、はるかに優れているではないか）、MAT 12:3（読んだことがないのか）、ACT 2:7（みなガリラヤ人ではないか）。"
  },
  {
   "id": "4",
   "label": "いいえ（単独の答え）",
   "label_en": "no (standalone answer)",
   "def": "答えとして単独で立つ οὔ 。「いいえ」「いや」。 ναί と対になる。",
   "note": "JHN 1:21（いいえ）、JHN 21:5（いいえ）、MAT 5:37（ οὒ οὔ ＝いいえ、いいえ）、JHN 7:12（いや、そうではない）。"
  }
 ],
 "idioms": [
