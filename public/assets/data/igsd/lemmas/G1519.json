{
 "lemma": "εἰς",
 "lemmaId": "grc:G1519",
 "strong": "G1519",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "〜の中へ（入る）",
   "def": "場所や容器の中へ入る動き。投げ込まれる・落ちる、も含む。",
   "note": "MAT 2:11（家の中へ入って）、MAT 5:29（ゲヘナに投げ込まれる）、MRK 1:9（ヨルダン川へ入って洗礼を受けた）。"
  },
  {
   "id": "2",
   "label": "〜へ（向かう・着く）",
   "def": "目的地への方向と到達。人々の間へ広がること、目を向けることも含む。",
   "note": "MAT 2:8（ベツレヘムへ）、MAT 6:26（空の鳥に目を向けよ）、MRK 4:7（いばらの間に落ちた）。"
  },
  {
   "id": "3",
   "label": "〜の上に（接触）",
   "def": "表面への接触。ほおを打つ、つばをかける、道に敷く。",
   "note": "MAT 5:39（右のほおを打つ）、MAT 27:30（顔につばをかけた）、MRK 11:8（道に敷いた）。"
  },
  {
   "id": "4",
   "label": "〜に（所在）",
   "def": "移動の結果として、そこにいる・あること。後期ギリシャ語では ἐν の代わりにもなる。",
   "note": "MAT 2:23（ナザレに住んだ）、JHN 1:18（父のふところにいる独り子）、ACT 8:23（苦い胆汁の中にいる）。"
  },
  {
   "id": "5",
   "label": "〜に対して（人への向き）",
   "def": "罪・愛・怒り・親切など、人に向けられる態度や行いの向き。誓いの拠り所にもなる。",
   "note": "MAT 18:21（私に対して罪を犯す）、ROM 5:8（私たちに対する愛を示した）、ACT 25:8（カエサルに対して罪を犯した）。"
  },
  {
   "id": "6",
   "label": "〜のために・〜として（目的・用途）",
   "def": "目的・用途・受ける人のため。「証しとして」「記念として」、 εἰς τό ＋不定詞の目的、悔い改め・赦しのため、も含む。",
   "note": "MAT 8:4（人々への証しとして）、MAT 5:13（何の役にも立たない）、MAT 3:11（悔い改めのために）、ACT 2:38（罪の赦しのために）。"
  },
  {
   "id": "7",
   "label": "〜まで・〜の間（時）",
   "def": "時の限界と長さ。「永遠に」「終わりまで」「翌日まで」「代々にわたって」。",
   "note": "MAT 10:22（最後まで耐え忍ぶ）、MRK 3:29（永遠に赦されない）、LUK 1:50（代々にわたって）、MAT 28:1（週の初めの日に向かう夜明け）。"
  },
  {
   "id": "8",
   "label": "〜に結ばれる（信仰・洗礼）",
   "def": " πιστεύω （信じる）と βαπτίζω （洗礼）の相手を導く形。「キリストを信じる」はキリストに身を委ね結ばれる言い方で、洗礼で名やキリストに結ばれるのも同じ。",
   "note": "JHN 2:11（弟子たちはイエスを信じた）、MAT 28:19（父と子と聖霊の名に洗礼を授け）、ROM 6:3（キリストに洗礼を受けた者は、その死に結ばれた）、GAL 3:27。"
  },
  {
   "id": "9",
   "label": "〜になる・〜に至る（結果・変化）",
   "def": "変化や行いの行き着く先。二つに分かれる、滅びや裁きに至る、義と認められる、も含む。",
   "note": "MAT 27:51（二つに裂けた）、ROM 4:3（信仰が義と認められた）、ROM 1:24（汚れに渡された）、1TI 2:4（真理の知識に至る）。"
  }
 ],
