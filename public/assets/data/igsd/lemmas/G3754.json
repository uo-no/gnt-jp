{
 "lemma": "ὅτι",
 "lemmaId": "grc:G3754",
 "strong": "G3754",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "〜ということ（内容）",
   "def": "知る・見る・言う・信じるなどの内容を導く。直接の言葉をそのまま引く前にも置かれ、その場合は訳されないことが多い。説明の「〜ということだ」も含む。",
   "note": "JHN 9:25（一つだけ知っている、〜ということ）、MAT 16:18（あなたはペトロ）、JHN 3:19（審判とは〜ということだ）、MRK 2:17（言葉をそのまま引く）。"
  },
  {
   "id": "2",
   "label": "〜だから（理由）",
   "def": "理由・根拠を導く。幸いの宣言、感謝や喜びの理由にもなる。",
   "note": "MAT 5:3・5:4（〜だから幸いだ）、REV 3:10（あなたが守ったから）、1JN 2:14（知っているから書く）。"
  }
 ],
 "idioms": [
  {
   "form": "λέγει ὅτι ＋直接の言葉",
   "gloss": "〜と（そのまま）言う",
   "refs": [
    "MAT 7:23",
    "MRK 2:17"
   ]
  },
  {
   "form": "διὰ τοῦτο ὅτι",
   "gloss": "〜だからこそ・そういうわけで",
   "refs": [
    "JHN 8:47",
    "JHN 10:17"
   ]
  },
  {
   "form": "οὐκ ὅτι … ἀλλ᾽ ὅτι",
   "gloss": "〜だからではなく、〜だから",
   "refs": [
    "JHN 6:26",
    "JHN 12:6"
   ]
  }
 ],
