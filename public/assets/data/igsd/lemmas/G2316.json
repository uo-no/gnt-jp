{
 "lemma": "θεός",
 "lemmaId": "grc:G2316",
 "strong": "G2316",
 "status": "final",
 "updated": "2026-11-10",
 "senses": [
  {
   "id": "1",
   "label": "神（唯一の真の神）",
   "label_en": "God (the one true God)",
   "def": "イスラエルの神、また新約において父なる神として告白される唯一の神。文脈上「神」が唯一の実在として前提されている場合に用いる。「神の子」の属格として現れる場合も、指すのは父なる神であるためここに含む。キリストへの適用（ヨハ1:1、20:28、ヘブ1:8）は独立語義を立てず、本語義の中で扱う。",
   "note": "マタ1:23、ロマ1:17、コリ一8:4、コリ一15:28。「神の子」の属格：マタ4:3, 16:16、ヨハ1:34, 20:31、ロマ1:4 等。キリストへの適用：ヨハ1:1（言は神であった）、ヨハ20:28、ヘブ1:8。"
  },
  {
   "id": "2",
   "label": "神々・神と呼ばれる存在",
   "label_en": "gods / beings called gods",
   "def": "ギリシャ・ローマ的多神教における諸神や偶像、または比喩的・引用文脈で「神」と呼ばれる存在を指す。",
   "note": "コリ一8:4-5、使14:11、使19:26、ガラ4:8。詩82:6 の引用（ヨハ10:34-35、人間の裁き人が「神々」と呼ばれる）もここ。"
  },
  {
   "id": "3",
   "label": "女神（固有名に付随）",
   "label_en": "goddess (with a proper name)",
   "def": "特定の女神の称号として用いられる θεός（女性用法）。",
   "note": "使19:37の1箇所のみ。"
  }
 ],
 "idioms": [
  {
   "form": "ὁ θεὸς καὶ πατήρ",
   "gloss": "「神にして父」。キリストの父としての神を指す定型的呼称",
   "refs": [
    "ROM 15:6",
    "EPH 1:3",
    "PHP 4:20",
    "COL 1:3"
   ]
  },
  {
   "form": "κύριος ὁ θεός",
   "gloss": "「主なる神」。LXX由来の呼称でヘブライ語 יהוה אלהים に相当",
   "refs": [
    "MAT 4:7",
    "MAT 4:10",
    "REV 4:8"
   ]
  }
 ],
