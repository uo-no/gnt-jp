{
 "lemma": "υἱός",
 "lemmaId": "grc:G5207",
 "strong": "G5207",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "神の子（イエス）",
   "def": "イエスを指す「神の子」。神が「わたしの子」と呼ぶ言葉も含む。",
   "note": "MAT 3:17、MAT 4:3、ROM 8:3、1JN 4:15。"
  },
  {
   "id": "2",
   "label": "人の子",
   "def": "イエスが自分を指す称号。ダニエル書の「人の子のような者」に由来する。",
   "note": "MAT 8:20、MAT 9:6、REV 1:13（人の子のような者）。"
  },
  {
   "id": "3",
   "label": "人間の子",
   "def": "親に対する子、男の子。「人の子ら」として人々一般を指す場合も含む。",
   "note": "MAT 1:21、MRK 3:28（人の子ら＝人々）。"
  },
  {
   "id": "4",
   "label": "子孫・末裔",
   "def": "血統のつながりを示す「〜の子」。イスラエルの子ら、ダビデの子（家系）など。信仰によってアブラハムの子らとされる場合も含む。",
   "note": "MAT 1:1、MAT 27:9（イスラエルの子ら）、GAL 3:7（信仰によるアブラハムの子ら）。"
  },
  {
   "id": "5",
   "label": "神の子ら（信者）",
   "def": "信じる者たちが神の子どもとされる用法。神の訓練を受ける子らも含む。",
   "note": "MAT 5:9、ROM 8:14、GAL 3:26、HEB 12:5-8（訓練を受ける子ら）。"
  },
  {
   "id": "6",
   "label": "〜の子ら（性質・所属）",
   "def": "「〜に属し、その性質を持つ者」を表す言い方。光の子ら、不従順の子ら、滅びの子、婚礼の客（花婿の部屋の子ら）など。固有名の由来説明も含む。",
   "note": "JHN 12:36（光の子ら）、EPH 2:2（不従順の子ら）、ACT 4:36（励ましの子＝バルナバ）。"
  },
  {
   "id": "7",
   "label": "動物の子",
   "def": "動物の子。",
   "note": "MAT 21:5（ろばの子）のみ。"
  }
 ],
 "idioms": [
  {
   "form": "υἱοὶ τοῦ νυμφῶνος",
   "gloss": "婚礼の客（花婿の付き添い）",
   "refs": [
    "MAT 9:15",
    "MRK 2:19"
   ]
  }
 ],
