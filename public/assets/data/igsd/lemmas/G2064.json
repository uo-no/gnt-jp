{
 "lemma": "ἔρχομαι",
 "lemmaId": "grc:G2064",
 "strong": "G2064",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "来る・行く",
   "def": "人がこちらへ来る、また来訪・到着すること。「来るべき方」（メシヤ）と再臨もここに含む。",
   "note": "MAT 2:2、MAT 11:3（来るべき方）、ACT 1:11（再び来る）。"
  },
  {
   "id": "2",
   "label": "到来する",
   "def": "時・日・出来事・御国などがやって来ること。",
   "note": "MAT 6:10（御国が来ますように）、MAT 9:15（日が来る）、JHN 4:21（時が来る）。"
  },
  {
   "id": "3",
   "label": "至る・現れる",
   "def": "ある状態に至る、明るみに出ること。",
   "note": "MRK 4:22（明るみに出る）、MRK 5:26（かえって悪くなる）、1TI 2:4（真理を知るに至る）。"
  }
 ],
 "idioms": [
  {
   "form": "ὁ ἐρχόμενος",
   "gloss": "来るべき方（メシヤの称号）",
