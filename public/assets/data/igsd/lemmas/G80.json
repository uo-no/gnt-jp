 "senses": [
  {
   "id": "1",
   "label": "兄弟（血縁）",
   "label_en": "brother (by blood)",
   "def": "同じ親から生まれた兄弟。家族や系図の文脈で使われる。",
   "note": ""
  },
  {
   "id": "2",
   "label": "兄弟（信仰の仲間）",
   "label_en": "brother (fellow believer)",
   "def": "同じ信仰を持つ仲間。キリスト者の共同体の成員同士を指し、手紙や説教での呼びかけにも使われる。",
   "note": "イエスの「わたしの兄弟」は弟子たちを指す（MAT 12:50、28:10）。"
  },
  {
   "id": "3",
   "label": "同胞・隣人",
   "label_en": "fellow countryman / neighbor",
   "def": "同じ民族・共同体に属する相手。ユダヤ人同士の呼びかけや、身近な人への教えの中で使われる。",
   "note": ""
  }
 ],
