 "senses": [
  {
   "id": "1",
   "label": "名前",
   "label_en": "name",
   "def": "人や場所につけられた名。名づけや名のりを指す場合を含む。",
   "note": ""
  },
  {
   "id": "2",
   "label": "名（その人の権威・臨在）",
   "label_en": "name (a person's authority / presence)",
   "def": "神やキリストについて、その名がその人そのもの、権威と力を表す用法。洗礼・祈り・宣教・苦難が「名によって」「名のために」と結びつく。",
   "note": ""
  },
  {
   "id": "3",
   "label": "人（数）",
   "label_en": "person (in a count)",
   "def": "「名」がそのまま人を数える言い方になる場合。",
   "note": "使徒 1:15、黙 3:4、11:13。"
  },
  {
   "id": "4",
   "label": "評判・名声",
   "label_en": "reputation / fame",
   "def": "人からどう見られているかという名。",
   "note": ""
  }
 ],
 "idioms": [
  {
   "form": "εἰς ὄνομα + 属格",
   "sense": "1",
   "def": "〜であるがゆえに（MAT 10:41）"
  },
  {
   "form": "κατ᾽ ὄνομα",
   "sense": "1",
   "def": "名ざしで・一人ひとりを名指しで（3JN 1:15）"
  }
