 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "空・天空",
   "label_en": "sky / heaven (firmament)",
   "def": "目に見える空。天気や鳥、星が関わる場面で使われる。",
   "note": ""
  },
  {
   "id": "2",
   "label": "天（神のいます所）",
   "label_en": "heaven (where God dwells)",
   "def": "神と天使たちがいる天上の世界。栄光や報い、祈りの向かう先。",
   "note": ""
  },
  {
   "id": "3",
   "label": "天（天地・全世界）",
   "label_en": "heaven (heaven and earth / the whole world)",
   "def": "「天と地」の対や「天の下」の形で、世界の全体を指す。",
   "note": ""
  },
  {
   "id": "4",
   "label": "天の御国の「天」",
   "label_en": "\"heaven\" in the kingdom of heaven",
   "def": "マタイに特有の「天の御国」という言い方の中の「天」。神を直接名指ししない敬虔な言い換えを含む表現。",
   "note": ""
  },
  {
   "id": "5",
   "label": "神（換称）",
   "label_en": "God (by metonymy)",
   "def": "「天」が神ご自身を指す言い換えとして使われる用法。",
   "note": "「天に対して罪を犯した」（LUK 15:18）は神に対しての意。"
  }
 ],
