{
 "lemma": "πατήρ",
 "lemmaId": "grc:G3962",
 "strong": "G3962",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "父なる神",
   "def": "神を父として指す用法。キリストの父として、また天の父として信じる者たちに関わる。",
   "note": "MAT 5:16（あなたがたの天の父）、JHN 5:36、1CO 1:3（挨拶）。"
  },
  {
   "id": "2",
   "label": "人間の父",
   "def": "肉の親としての父。文脈によっては両親を指す。",
   "note": "MAT 4:21（ゼベダイ）、HEB 11:23（モーセの両親）、HEB 12:9（肉の父たち）。"
  },
  {
   "id": "3",
   "label": "先祖",
   "def": "祖先・父祖たち。アブラハムを「わたしたちの父」と呼ぶ血統上の用法も含む。",
   "note": "MAT 3:9、MAT 23:30、JHN 8:39（アブラハム）。"
  },
  {
   "id": "4",
   "label": "源・起源（〜の父）",
   "def": "ある性質や集団の出どころを「父」と呼ぶ比喩的な用法。信仰の父、偽りの父、霊的な父など。",
   "note": "ROM 4:11（信仰の父アブラハム）、JHN 8:44（偽りの父＝悪魔）、1CO 4:15（霊的な父パウロ）。"
  },
  {
   "id": "5",
   "label": "尊称（父たち）",
   "def": "目上の人や信仰の年長者への呼びかけ・称号としての「父」。",
   "note": "ACT 7:2・22:1（呼びかけ）、1JN 2:13（年長の信者たち）、MAT 23:9（称号としての父）。"
  }
 ],
 "idioms": [
  {
   "form": "πατὴρ τῶν φώτων",
   "gloss": "光の父（神）",
   "refs": [
    "JAS 1:17"
   ]
  },
  {
   "form": "προστίθημι πρὸς τοὺς πατέρας",
   "gloss": "先祖のもとに加えられる（死ぬ）",
   "refs": [
    "ACT 13:36"
   ]
  }
 ],
