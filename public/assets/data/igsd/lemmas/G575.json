{
 "lemma": "ἀπό",
 "lemmaId": "grc:G575",
 "strong": "G575",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "〜から（場所・距離・方角）",
   "label_en": "from (place / distance / direction)",
   "def": "場所を離れる起点。遠くから、方角（東から）も含む。",
   "note": "MAT 3:13、MAT 2:1（東から）、MAT 26:58（遠くから＝ ἀπὸ μακρόθεν）、REV 21:13。"
  },
  {
   "id": "2",
   "label": "〜から離れて（分離・解放・用心）",
   "label_en": "away from (separation / release / caution)",
   "def": "罪や悪から離れる・救い出される・取り去られること。「〜に気をつけよ（ προσέχετε ἀπό ）」の対象も含む。",
   "note": "MAT 1:21（罪から救う）、MAT 6:13、MAT 7:15（偽預言者に気をつけよ）、1TH 1:9（偶像から離れて）。"
  },
  {
   "id": "3",
   "label": "〜の一部・中から",
   "label_en": "from among / part of",
   "def": "全体の中から一部を取り出すこと。少しだけ、部分的に、も含む。",
   "note": "MAT 27:21（どちらを）、MAT 15:27（食卓から落ちるパン屑）、ROM 15:15（一部分は）。"
  },
  {
   "id": "4",
   "label": "〜から（源・出自・行為者）",
   "label_en": "from (source / origin / agent)",
   "def": "物事の出どころ。人や町の出自、神から与えられるもの、行為の担い手。材料も含む。",
   "note": "EPH 1:2（神から）、JHN 3:2（神から来た）、MAT 21:11（ナザレ出身の）、HEB 13:24（イタリアから来た人々）。"
  },
  {
   "id": "5",
   "label": "〜から・〜以来（時・起点）",
   "label_en": "from / since (time / starting point)",
   "def": "時の起点。「初めから」「その時から」。順序の起点（アダムから数えて）も含む。",
   "note": "MAT 19:4（初めから）、LUK 1:70（昔から）、ROM 5:14（アダムからモーセまで）、MAT 20:8（最後の者から始めて）。"
  },
  {
   "id": "6",
   "label": "〜のために（原因）",
   "label_en": "because of (cause)",
   "def": "感情や出来事の原因。「喜びのあまり」「恐れのために」。恐れる対象も含む。",
   "note": "MAT 13:44（喜びのあまり）、MAT 14:26（恐れのために）、MAT 10:28（恐れるべき方）。"
  },
  {
   "id": "7",
   "label": "自ら・自力で",
   "label_en": "on one's own / by oneself",
   "def": "ἀφ' ἑαυτοῦ で「自分の考えで・独力で」。",
   "note": "LUK 12:57、JHN 7:28、JHN 11:51（自分から言ったのではない）。"
  }
 ],
