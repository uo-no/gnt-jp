   "id": "1",
   "label": "か・または",
   "label_en": "or",
   "def": "選択肢を並べる。「〜か〜か」「どちらか」。 ἢ…ἤ で「〜か、それとも〜か」。反語の問い（〜ではあるまい）にも現れる。",
   "note": "MAT 5:17、MAT 6:24（二人の主人に）、MAT 9:5（どちらが易しいか）、MAT 6:31。"
  },
  {
   "id": "2",
   "label": "〜より",
   "label_en": "than",
   "def": "比較を表す。「〜よりも」。 πρὶν ἤ で「〜するより前に」。",
   "note": "MAT 10:15、MAT 18:8（両目で入るより）、MAT 1:18（一緒になる前に）、MRK 9:43。"
  }
 ],
