 "senses": [
  {
   "id": "1",
   "label": "〜するために（目的）",
   "def": "目的を導く。「〜するために」「〜するように（目的）」。預言の成就の定型（成就するため）も含む。",
   "note": "MAT 1:22（成就するために）、MAT 7:1（裁かれないため）、MRK 1:38（そのために）、JHN 3:15。"
  },
  {
   "id": "2",
   "label": "〜するように（内容・依頼）",
   "def": "求め・命令・願いの内容を示す。「〜するように（言った・願った）」。",
   "note": "MAT 4:3（命じて…なるように）、MAT 7:12（してほしいと願う）、MRK 7:26（追い出してくださるよう）。"
  },
  {
   "id": "3",
   "label": "〜する結果になって",
   "def": "結果としてそうなること。意図よりも成り行きとしての結果。",
   "note": "LUK 9:45（悟らないようになっていた）、JHN 9:2・9:3、LUK 8:10。"
  }
 ],
