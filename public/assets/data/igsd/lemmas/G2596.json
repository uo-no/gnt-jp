{
 "lemma": "κατά",
 "lemmaId": "grc:G2596",
 "strong": "G2596",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "基準・準拠",
   "label_en": "according to (standard / conformity)",
   "label_es": "según (norma / conformidad)",
   "def": "対格の名詞が示す基準・規範に沿って事柄が成り立つことを表す。「〜に従って」「〜のとおりに」",
   "note": "律法・約束・御心・言葉などに沿う用例が中心（MAT 2:16、ROM 8:4、HEB 7:16）。報告・報いが「行いに応じて」決まる文脈もここ（REV 20:12）。"
  },
  {
   "id": "2",
   "label": "対立・敵対",
   "label_en": "against (opposition)",
   "label_es": "contra (oposición)",
   "def": "属格の相手に向かう敵対・反対の向きを表す。告訴・非難・戦い・内面の対立など。「〜に逆らって」「〜に対して」",
   "note": "支配格は属格（MAT 10:35、MAT 12:30、ROM 8:33、GAL 5:17）。ὑπέρ（〜のために）の対になる用法。"
  },
  {
   "id": "3",
   "label": "分配・反復",
   "label_en": "each / by (distribution / repetition)",
   "label_es": "cada / por (distribución / repetición)",
   "def": "場所・時間・数量を一つずつ区切って繰り返し配る働きを表す。「〜ごとに」「〜ずつ」",
   "note": "καθ' ἡμέραν（LUK 9:23）、κατὰ πόλιν（LUK 8:1）、κατ' ἔτος（LUK 2:41）、κατὰ πᾶν σάββατον（ACT 13:27）、καθ' ἕν ἕκαστον（ACT 21:19）。"
  },
  {
   "id": "4",
   "label": "関係・観点",
   "label_en": "with respect to (relation / viewpoint)",
   "label_es": "con respecto a (relación / punto de vista)",
   "def": "対格の名詞が示す面・観点において事柄を見る働きを表す。「〜の面では」「〜に関して」",
   "note": "κατὰ σάρκα（ROM 1:3、ROM 9:3、2CO 5:16）、κατὰ πάντα「すべての点で」（HEB 4:15）、PHP 3:5–6 の「律法の面では」。"
  },
  {
   "id": "5",
   "label": "様態・手段",
   "label_en": "in the manner of / by (manner / means)",
   "label_es": "a la manera de / por (manera / medio)",
   "def": "出来事が置かれた状態・方法・根拠を表す。「〜の中で」「〜によって」「〜の仕方で」",
   "note": "κατ' ὄναρ「夢の中で」（MAT 1:20 ほか）、κατὰ ἄγνοιαν（ACT 3:17）、κατὰ γνῶσιν（1PE 3:7）、καθ' ὑπερβολήν「度を越えて」（ROM 7:13）。"
  },
  {
   "id": "6",
   "label": "個別・単独",
   "label_en": "individually / alone",
   "label_es": "individualmente / a solas",
   "def": "他と離れて単独である状態、内輪であることを表す。「人目を離れて」「ひとりで」",
   "note": "κατ' ἰδίαν（MAT 14:13、MAT 17:19）、κατὰ μόνας（MRK 4:10、LUK 9:18）、καθ' ἑαυτήν「それ自体では」（JAS 2:17）。"
  },
  {
   "id": "7",
   "label": "空間の広がり",
   "label_en": "throughout (spatial extent)",
   "label_es": "por todo (extensión espacial)",
   "def": "地域全体に及ぶ広がりを表す。支配格は対格が中心だが属格の例もある。「〜一帯に」「〜の至る所で」",
   "note": "καθ' ὅλης τῆς Ἰουδαίας（LUK 4:14、ACT 9:31。いずれも属格）、κατὰ τὴν οἰκουμένην（ACT 24:5）。"
  },
  {
   "id": "8",
   "label": "方向",
   "label_en": "toward (direction)",
   "label_es": "hacia (dirección)",
   "def": "対格の場所・目標に向かう移動や向きを表す。「〜に向かって」「〜の方へ」",
   "note": "κατὰ σκοπόν（PHP 3:14）、κατὰ τὴν Μυσίαν（ACT 16:7）、κατὰ μεσημβρίαν「南へ」（ACT 8:26）。"
  },
  {
   "id": "9",
   "label": "帰属・当事者",
   "label_en": "belonging to / party to",
   "label_es": "perteneciente a / parte en",
   "def": "対格の人・集団に属する事柄や、その人の側の範囲を示す。「〜のもとにある」「〜の側の」",
   "note": "τῶν καθ' ὑμᾶς ποιητῶν「あなたがたの詩人たち」（ACT 17:28）、ἡ καθ' ὑμᾶς πίστις（EPH 1:15）、家にある教会（COL 4:15、ROM 16:5）。"
  },
  {
   "id": "10",
   "label": "経路",
   "label_en": "along (route)",
   "label_es": "a lo largo de (ruta)",
   "def": "対格の道・土地に沿って進む移動を表す。「〜に沿って」",
   "note": "κατὰ τὴν ὁδόν（ACT 8:36、ACT 26:13）、ACT 27:7 の沿岸航行。"
  },
  {
   "id": "11",
   "label": "時期",
   "label_en": "at (time)",
   "label_es": "en (tiempo)",
   "def": "対格の時を出来事の時期として示す。「〜の頃に」「〜に」",
   "note": "κατὰ καιρόν（ROM 5:6、ROM 9:9）、κατὰ τὸ μεσονύκτιον「真夜中ごろ」（ACT 16:25）、κατ' ἀρχάς（HEB 1:10）。"
  },
  {
   "id": "12",
   "label": "対面・面前",
   "label_en": "before / in the presence of (face to face)",
   "label_es": "delante de / en presencia de (cara a cara)",
   "def": "対格の顔・目の前にある状態を示す。本人の面前での対面や、外見としての現れを含む。「面と向かって」「目の前に」",
   "note": "κατὰ πρόσωπον（GAL 2:11、ACT 25:16）、κατ' ὀφθαλμούς（GAL 3:1）、τὰ κατὰ πρόσωπον「外見」（2CO 10:7）。"
  },
  {
   "id": "13",
   "label": "下方",
   "label_en": "down / downward",
   "label_es": "abajo / hacia abajo",
   "def": "属格の場所から下へ向かう移動、または下へ垂れる状態を表す。「〜を下って」",
   "note": "κατὰ τοῦ κρημνοῦ（MAT 8:32、MRK 5:13、LUK 8:33）、κατὰ κεφαλῆς ἔχων（1CO 11:4）。2CO 8:2 の κατὰ βάθους「深みに達する（貧しさ）」もここに置く。"
  },
  {
   "id": "14",
   "label": "誓約",
   "label_en": "by (oath)",
   "label_es": "por (juramento)",
   "def": "属格の者を証人・権威として誓うことを表す。「〜によって誓う」",
   "note": "MAT 26:63（神によって誓わせる）、HEB 6:13、HEB 6:16。"
  }
 ],
