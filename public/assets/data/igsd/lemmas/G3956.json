{
 "lemma": "πᾶς",
 "lemmaId": "grc:G3956",
 "strong": "G3956",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "すべての・あらゆる",
   "label_en": "every / all",
   "def": "成員の一つひとつに及ぶ全体。「すべての人」「あらゆる病」「すべての点で」。否定と結ぶと「一つも〜ない」になる。",
   "note": "MAT 2:3、MAT 4:23（あらゆる病を）、ROM 5:12、EPH 1:3（あらゆる霊の祝福）。"
  },
  {
   "id": "2",
   "label": "すべて（総体）",
   "label_en": "all (totality)",
   "def": "物事をひとかたまりの総体として指す「すべて」。",
   "note": "MAT 11:27（すべてのことが委ねられた）、MAT 18:26（全部返す）、HEB 1:3。"
  },
  {
   "id": "3",
   "label": "誰でも・何でも",
   "label_en": "everyone / everything",
   "def": "任意の一つを指す。「誰でも」「何でも」「どんな理由でも」。",
   "note": "MAT 19:3（どんな理由であれ）、MRK 7:18、MAT 18:19。"
  },
  {
   "id": "4",
   "label": "最大限の・心からの",
   "label_en": "utmost / wholehearted",
   "def": "程度の完全さを表す。「全き〜」「心からの〜」。",
   "note": "ACT 4:29（大胆に＝臆することなく）、ACT 17:11（熱心に）、PHP 2:29。"
  },
  {
   "id": "5",
   "label": "いつも・絶えず",
   "label_en": "always / continually",
   "def": "διὰ παντός の形で、時間の継続を表す。",
   "note": "MAT 18:10、ACT 10:2、HEB 13:15（絶えず賛美のいけにえを）。"
  }
 ],
