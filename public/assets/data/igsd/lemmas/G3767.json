 "senses": [
  {
   "id": "1",
   "label": "推論・帰結",
   "label_en": "therefore / then (inference / consequence)",
   "def": "前の内容を根拠として、結論・勧め・問いを引き出す働き。「だから」「それでは」",
   "note": "MAT 3:10（警告の結論）、ROM 6:12（勧め）、ROM 9:14 の Τί οὖν（問いの形の推論）、JAS 5:7（忍耐の勧め）。書簡に多い。"
  },
  {
   "id": "2",
   "label": "継続・再開",
   "label_en": "continuation / resumption",
   "def": "物語や対話の流れを受けて、次の場面・発言へ進める働き。脱線からの再開や場面転換も含む。「そこで」「さて」",
   "note": "ヨハネの εἶπεν οὖν／λέγει οὖν（JHN 4:46、18:12）、使徒行伝の μέν οὖν（ACT 2:41、9:31）、HEB 9:1 の話題再開。"
  }
 ],
 "idioms": [
