{
 "lemma": "ἐκ",
 "lemmaId": "grc:G1537",
 "strong": "G1537",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "〜の中から・〜から（出発・分離）",
   "label_en": "out of / from (departure / separation)",
   "label_es": "de entre / de (partida / separación)",
   "def": "内側から外へ出ること、危険や支配から抜け出すこと。死者の中から（復活）も含む。",
   "note": "MAT 17:9（死者の中からよみがえる）、MAT 7:4・7:5（目の中の梁）、JHN 12:27（この時から救ってください）、REV 9:1（天から落ちた星）。"
  },
  {
   "id": "2",
   "label": "〜の中の（部分・一員）",
   "label_en": "of / among (part / member)",
   "label_es": "de entre (parte / miembro)",
   "def": "全体の中から取り出される一部、集団の一員であること。 ἐκ μέρους で「部分的に」。",
   "note": "MAT 6:27（あなたがたのうち誰が）、MAT 10:29（一つが）、REV 7:5（ユダ族から）、1CO 13:9（部分的に知る）。"
  },
  {
   "id": "3",
   "label": "〜から（由来・出生・所属）",
   "label_en": "from (origin / birth / affiliation)",
   "label_es": "de (origen / nacimiento / pertenencia)",
   "def": "生まれ・血筋・出自、そのものがどこから来たか。御霊から生まれる、神から出た、も含む。",
   "note": "MAT 1:3（タマルから生んだ）、JHN 3:5・3:6（御霊から生まれる）、JHN 1:13（神から生まれた）、1JN 4:6（神から出た者）。"
  },
  {
   "id": "4",
   "label": "〜によって（根拠・基準・手段）",
   "label_en": "by (basis / standard / means)",
   "label_es": "por (base / norma / medio)",
   "def": "行いや裁きの根拠・基準になるもの。信仰によって、行いによって、言葉によって裁かれる、の型。",
   "note": "ROM 3:30（信仰によって義とする）、ROM 14:23（信仰から出ていないことは罪）、MAT 12:37（言葉によって義とされる）、JAS 2:24。"
  },
  {
   "id": "5",
   "label": "〜が原因で",
   "label_en": "because of",
   "label_es": "a causa de",
   "def": "苦しみや死などの原因になるものによって。",
   "note": "JHN 4:6（旅に疲れて）、REV 8:11（水のために死んだ）、REV 16:10（苦痛のために）。"
  },
  {
   "id": "6",
   "label": "心の内から（動機・心情）",
   "label_en": "from within the heart (motive / feeling)",
   "label_es": "desde dentro del corazón (motivo / sentimiento)",
   "def": "心・魂の内側から湧き出る動機や態度。真心から、嫌々ながら、党派心から。",
   "note": "MRK 12:30（心を尽くして）、EPH 6:6（心から）、2CO 9:7（嫌々ながらではなく）、PHP 1:16（愛から）。"
  },
  {
   "id": "7",
   "label": "〜以来（時）",
   "label_en": "since (time)",
   "label_es": "desde (tiempo)",
   "def": "時の起点。生まれつき、若い時から、初めから。 ἐκ τούτου で「それ以来・その時から」。",
   "note": "MRK 9:21（幼い時から）、MRK 10:20（若い時から）、JHN 9:32（世の初めから）、JHN 19:12（それ以来）。"
  },
  {
   "id": "8",
   "label": "右に・左に（位置）",
   "label_en": "on the right / on the left (position)",
   "label_es": "a la derecha / a la izquierda (posición)",
   "def": "ἐκ δεξιῶν／ἐξ εὐωνύμων で、右側・左側の位置。向かい側も含む。",
   "note": "MAT 22:44（私の右に座れ）、MRK 16:19（神の右に座した）、LUK 1:11（祭壇の右に立つ）。"
  },
  {
   "id": "9",
   "label": "〜でできた（材料）",
   "label_en": "made of (material)",
   "label_es": "hecho de (material)",
   "def": "品物が作られる材料。",
   "note": "MAT 27:29（茨で編んだ冠）、JHN 2:15（縄で作った鞭）、REV 21:21（一つの真珠でできた門）。"
  },
  {
   "id": "10",
   "label": "二度目・三度目（反復）",
   "label_en": "a second / third time (repetition)",
   "label_es": "por segunda / tercera vez (repetición)",
   "def": "ἐκ δευτέρου／ἐκ τρίτου で、回数を表す。",
   "note": "MAT 26:42（二度目）、MAT 26:44（三度目）、HEB 9:28（二度目に現れる）。"
  }
 ],
