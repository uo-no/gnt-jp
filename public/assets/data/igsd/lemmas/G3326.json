{
 "lemma": "μετά",
 "lemmaId": "grc:G3326",
 "strong": "G3326",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "〜と共に",
   "def": "人や物と一緒にいる・行く・あること。神が共にいて助けることも含む。属格の名詞を伴う。",
   "note": "MAT 1:23（インマヌエル＝神は我々と共に）、MRK 1:13（野の獣と共に）、ACT 10:38（神が彼と共にいた）。"
  },
  {
   "id": "2",
   "label": "〜を伴って",
   "def": "喜び・感謝・誓い・力など、様態や随伴するものを伴うこと。属格を伴う。",
   "note": "MAT 13:20（喜びをもって＝喜んで）、1TI 4:4（感謝をもって）、MAT 24:30（力と栄光を伴って）。"
  },
  {
   "id": "3",
   "label": "〜との関わり",
   "def": "会話・交渉・勘定・争いなど、相手とのやり取り。戦いの相手を指して「〜に対して」の意味にもなる。",
   "note": "REV 17:1（私に語りかけた）、1CO 6:6（兄弟同士の訴え）、REV 12:7（竜と戦う）。"
  },
  {
   "id": "4",
   "label": "〜の後で",
   "def": "時間的な後続。「〜の後」「その後」。対格の名詞を伴う。",
   "note": "MAT 17:1（六日の後）、MAT 24:29（苦難の後）、REV 4:1（その後で）。"
  },
  {
   "id": "5",
   "label": "〜の後ろに",
   "def": "場所的な後方。第二の幕の後ろに（HEB 9:3 のみ）。",
   "note": "HEB 9:3。"
  }
 ],
 "idioms": [
  {
   "form": "μετὰ ταῦτα",
   "gloss": "その後で",
   "refs": [
    "REV 4:1",
    "REV 7:9"
   ]
  }
 ],
