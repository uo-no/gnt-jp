 "senses": [
  {
   "id": "1",
   "label": "知っている",
   "def": "事実や事柄、人について知っている。内容を把握している場合を含む。",
   "note": "神を「知らない」は、関係の外にいることを表す（1TH 4:5）。"
  },
  {
   "id": "2",
   "label": "〜するすべを知っている",
   "def": "不定詞や πῶς を伴い、しかたや心得を知っていることを表す。",
   "note": ""
  },
  {
   "id": "3",
   "label": "敬う・重んじる",
   "def": "人を知っていることが、その人を認めて重んじる意味になる用法。",
   "note": "1TH 5:12 のみ。"
  }
 ],
