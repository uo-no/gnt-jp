  {
   "id": "1",
   "label": "（対比の前置き）〜は確かに",
   "def": "後に来る内容（多くは δέ の節）と対にして、まず一方を認める。",
   "note": "相手なしで「確かに〜だが」の含みを持つ場合を含む。"
  },
  {
   "id": "2",
   "label": "（配分）あるものは〜",
   "def": "「あるものは〜、あるものは〜」と並べる言い方の、最初の一方。",
   "note": ""
  },
  {
   "id": "3",
   "label": "（つなぎ）さて・そこで",
   "def": "話を次へ進める（多くは μέν οὖν の形で）。",
   "note": ""
  }
 ],
