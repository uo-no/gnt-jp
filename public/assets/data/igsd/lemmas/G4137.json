{
 "lemma": "πληρόω",
 "lemmaId": "grc:G4137",
 "strong": "G4137",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "満たす・満ちさせる",
   "def": "容器・場所・人をいっぱいにする。心が悲しみや欺きで満たされる場合（JHN 16:6、ACT 5:3）、欠けた必要を補う場合（PHP 4:18-19）を含む。",
   "note": ""
  },
  {
   "id": "2",
   "label": "完成する・満ち足りる",
   "def": "喜び・従順・働きなどが完全な状態に達する。キリストにあって満たされ完成している場合（COL 2:10）を含む。",
   "note": ""
  },
  {
   "id": "3",
   "label": "（時・期間が）満ちる",
   "def": "定められた期間が終わりまで達する。歳月・日数・「時」についての用例。",
   "note": ""
  },
  {
   "id": "4",
   "label": "成し遂げる・果たす",
   "def": "務め・使命・宣教・言葉を最後までやり遂げる。福音をあまねく宣べ伝える場合（ROM 15:19、COL 1:25）を含む。",
   "note": ""
  },
  {
   "id": "5",
   "label": "（預言・律法を）成就する",
   "def": "預言・聖書の言葉・律法が出来事として実現する。「〜するために起こった」という成就の定型を含む。",
   "note": ""
  }
 ],
