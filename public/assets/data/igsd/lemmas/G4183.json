{
 "lemma": "πολύς",
 "lemmaId": "grc:G4183",
 "strong": "G4183",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "数が多い",
   "def": "数えられるものが多いこと。人々や物の多数。",
   "note": "MAT 3:7、MAT 7:22、MAT 13:17（多くの預言者）。"
  },
  {
   "id": "2",
   "label": "量が多い",
   "def": "時間・騒ぎ・労苦など、数えられない量が多いこと。",
   "note": "MAT 9:37（収穫は多い）、JHN 7:12（大きな噂）、COL 4:13（多くの労苦）。"
  },
  {
   "id": "3",
   "label": "大きい・甚だしい",
   "def": "規模や程度が大きいこと。副詞的に「大いに・甚だしく」も含む。",
   "note": "MAT 4:25（大きな群衆）、MAT 24:30（大いなる栄光）、MRK 5:10（切に願った）。"
  },
  {
   "id": "4",
   "label": "よりまさる",
   "def": "比較の言い方で、量や価値が「〜より勝っている」こと。最も多い、の最上級も含む。",
   "note": "MAT 5:20、MAT 12:41（ヨナに勝るもの）、MAT 6:30（まして〜なおさら）、1CO 14:27（多くても）。"
  },
  {
   "id": "5",
   "label": "時間・頻度",
   "def": "時間の長さや繰り返しの多さ。長く、しばしば、（時刻が）遅く。",
   "note": "ACT 20:9（長く）、MAT 9:14（しばしば）、MRK 6:35（時刻が遅くなって）。"
  }
 ],
