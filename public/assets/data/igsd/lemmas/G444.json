{
 "lemma": "ἄνθρωπος",
 "lemmaId": "grc:G444",
 "strong": "G444",
 "status": "final",
 "updated": "2026-11-10",
 "senses": [
  {
   "id": "1",
   "label": "人間（総称・人類）",
   "label_en": "human being (humankind)",
   "def": "性別・身分を問わない人間一般。神・天使・動物との対比で「人間であること」が主題となる文脈、また不定代名詞的に用いられる。",
   "note": "マタ4:4、ヨハ16:21、ロマ7:1。κατὰ ἄνθρωπον：ロマ3:5, コリ一9:8, ガラ3:15。"
  },
  {
   "id": "2",
   "label": "人・ある人物（特定・不定）",
   "label_en": "person / a certain man (specific or indefinite)",
   "def": "話の文脈で登場する特定または不特定の人物を指す。職業・身分の修飾語を伴う場合も多い。",
   "note": "マタ7:9、マコ12:1、ヨハ5:5。ὁ ἄνθρωπος 定冠詞付きで前述の特定人物を指す場合も含む。"
  },
  {
   "id": "3",
   "label": "人の子（称号の一部としての『人』）",
   "label_en": "\"man\" in the title Son of Man",
   "def": "ὁ υἱὸς τοῦ ἀνθρώπου（人の子）という称号表現の中で現れる ἄνθρωπος。ダニエル書7章の「人のような者」に由来し、イエスが自己言及に用いる称号の一部をなす。",
   "note": "マタ8:20「人の子には枕する場所もない」、マタ9:6, 16:27, 24:30、ヨハ1:51, 3:14 等。複合表現としては idioms にも記録。"
  },
  {
   "id": "4",
   "label": "古い人・新しい人（人格的次元）",
   "label_en": "old man / new man (personal dimension)",
   "def": "ὁ παλαιὸς / καινὸς / νέος ἄνθρωπος として現れ、罪に支配された旧来の人格的在り方（古い人）または神に造り変えられた新たな在り方（新しい人）を指す神学的表現。",
   "note": "ロマ6:6、エフェ2:15、エフェ4:22, 24、コロ3:9-10。"
  },
  {
   "id": "5",
   "label": "内なる人（人格の内的次元）",
   "label_en": "inner man (inner dimension of the person)",
   "def": "ὁ ἔσω / ἔξω ἄνθρωπος として現れ、人の内面的・霊的次元（内なる人）または外面的・身体的次元（外なる人）を指す。",
   "note": "ロマ7:22、エフェ3:16、コリ二4:16、ペテ一3:4。"
  }
 ],
 "idioms": [
  {
   "form": "ὁ υἱὸς τοῦ ἀνθρώπου",
   "gloss": "「人の子」。イエスの自己言及的称号。ダニエル書7:13の終末論的「人の子」と結びつく",
   "refs": [
    "MAT 8:20",
    "MAT 11:19",
    "MAT 16:27",
    "MAT 24:30",
    "JHN 1:51",
    "JHN 3:14"
   ]
  },
  {
   "form": "ἄνθρωπος τοῦ θεοῦ",
   "gloss": "「神の人」。神に遣わされた人物・預言者的権威を持つ者への称号",
   "refs": [
    "1TI 6:11",
    "2TI 3:17"
   ]
  }
