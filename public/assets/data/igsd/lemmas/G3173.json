 "senses": [
  {
   "id": "1",
   "label": "大きい・激しい（量・程度）",
   "label_en": "great / intense (quantity / degree)",
   "label_es": "grande / intenso (cantidad / grado)",
   "def": "物の大きさ・規模・強度・程度が著しいことを表す。物理的な大きさから感情・出来事の激しさまで広く用いる。",
   "note": "マタ2:10「大きな喜び」、マタ4:16、マタ7:27、マコ4:41、ルカ4:38、黙6:4、ヨハ6:18、使4:33。"
  },
  {
   "id": "2",
   "label": "偉大な・重要な（地位・価値）",
   "label_en": "great / important (rank / value)",
   "label_es": "grande / importante (rango / valor)",
   "def": "人物・事柄の重要性・価値・地位が高いことを表す。比較級・最上級の用法も含む。",
   "note": "マタ5:19「天の国で大きい者」、マタ18:1、マタ22:36, 38「最も重要な戒め」、テト2:13「偉大な神」。"
  },
  {
   "id": "3",
   "label": "大きな（物理的規模・寸法）",
   "label_en": "great (physical size / dimension)",
   "label_es": "grande (tamaño físico / dimensión)",
   "def": "物体の寸法・体積・物理的広がりが大きいことを表す。",
   "note": "マタ13:32、マタ27:60、マコ4:32。"
  },
  {
   "id": "4",
   "label": "長い（時間・距離）",
   "label_en": "long (time / distance)",
   "label_es": "largo (tiempo / distancia)",
   "def": "時間的な長さ・程度の大きさを表す。",
   "note": "使26:29（μεγάλῳ）。"
  }
 ],
