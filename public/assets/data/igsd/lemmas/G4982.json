{
 "lemma": "σῴζω",
 "lemmaId": "grc:G4982",
 "strong": "G4982",
 "status": "final",
 "updated": "2026-11-10",
 "senses": [
  {
   "id": "1",
   "label": "救済する（霊的・終末論的）",
   "def": "罪や霊的滅びから人を救い出すこと。過去の出来事（贖罪）・現在の経験（恵みのうちに歩む）・将来の完成（終末の栄光）のいずれの時制でも用いられ、新約の「救い」の中心的用法。",
   "note": "ἀπὸ τῶν ἁμαρτιῶν（マタ1:21）、σεσῳσμένοι（エフェ2:5, 8）、οἱ σῳζόμενοι（使2:47, コリ一1:18）、σωθησόμεθα（ロマ5:9, 13:11）の三時制で用いられる。"
  },
  {
   "id": "2",
   "label": "救助する（危険・苦難から）",
   "def": "物理的な危険・苦難・死から人を助け出すこと。嵐・溺れ・迫害・殺害など切迫した脅威からの救出を指し、霊的含意を必ずしも持たない。",
   "note": "マタ8:25（嵐の中で）、マタ14:30、マコ15:30-31（十字架上で自分を救え）、ルカ23:35, 37, 39。τὴν ψυχήν（命）を目的語に取る場合も物理的生存を指すことが多い。"
  },
  {
   "id": "3",
   "label": "癒す（病気・苦しみから）",
   "def": "病気や身体的苦しみから回復させること。イエスの奇跡的癒しの場面で用いられ、現代語の「治癒する」に近い。",
   "note": "マタ9:21-22「あなたの信仰があなたを癒した」、マコ5:34, ルカ8:48、マコ5:23、ルカ18:42。"
  }
 ],
 "idioms": [
  {
   "form": "ἡ πίστις σου σέσωκέν σε",
   "gloss": "「あなたの信仰があなたを救った（癒した）」。語義3（癒し）と語義1（赦し・救済）の両文脈に現れる定式表現",
