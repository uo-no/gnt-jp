{
 "lemma": "ἀλλά",
 "lemmaId": "grc:G235",
 "strong": "G235",
 "status": "final",
 "updated": "2026-11-12",
 "senses": [
  {
   "id": "1",
   "label": "訂正",
   "label_en": "correction",
   "def": "前の否定（明示された否定のほか、省略された否定や直前の文脈の否定を含む）を受けて、その内容を退け、正しい内容に置き換える働き。「〜ではなく〜」",
   "note": "MAT 5:17、JHN 9:3、MAT 10:20（語る者の置き換え）。目的を置き換える ἀλλ' ἵνα（JHN 1:8）もここ。PHP 2:7 のように否定が前の節にある場合も含む。"
  },
  {
   "id": "2",
   "label": "拡大",
   "label_en": "expansion",
   "def": "「〜だけでなく、〜もまた」と、前の内容を保ったまま範囲を付け加える働き。多くは οὐ μόνον … ἀλλὰ καί の形を取る。",
   "note": "ROM 5:3、JHN 5:18、1JN 2:2、MAT 4:4（パンだけで、ではない）。"
  },
  {
   "id": "3",
   "label": "逆接・転換",
   "label_en": "contrast / shift",
   "def": "前の内容と対照的な事柄へ話を転じる働き。否定の置き換えではなく、対照・意外性・話題の切り替えを示す。「しかし」「ところが」。命令や依頼の導入、発言の切り替えにも使う。",
   "note": "JHN 16:7、ACT 26:16（命令の導入）、2CO 7:11（両面の列挙）、REV 2:4。"
  },
  {
   "id": "4",
   "label": "譲歩の帰結",
   "label_en": "concession and consequence",
   "def": "条件や譲歩の前提を受けて、「それでも」「せめて」と帰結の側を保つ働き。ἀλλὰ γε の形もここに置く。",
   "note": "MRK 14:29、1CO 9:2（ἀλλὰ γε）、COL 2:5、1CO 4:15。"
  },
  {
   "id": "5",
   "label": "例外",
   "label_en": "exception",
   "def": "ἀλλ' ἤ の形で、「〜以外のもの」を示す働き。",
   "note": "2CO 1:13、LUK 12:51 の2件のみ。"
  }
 ],
 "idioms": [
  {
   "form": "οὐ μόνον … ἀλλὰ καί",
   "gloss": "〜だけでなく〜もまた",
   "refs": [
    "ROM 5:3",
    "JHN 5:18"
   ]
  },
  {
   "form": "ἀλλὰ γε",
   "gloss": "せめて〜だけでも",
   "refs": [
    "1CO 9:2"
   ]
  },
  {
   "form": "ἀλλ' ἵνα",
   "gloss": "（そうではなく）〜するために",
   "refs": [
    "JHN 1:8",
    "JHN 9:3"
   ]
  },
  {
   "form": "ἀλλ' ἤ",
   "gloss": "〜以外（のもの）",
   "refs": [
    "2CO 1:13"
   ]
  }
 ],
