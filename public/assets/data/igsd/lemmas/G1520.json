 "senses": [
  {
   "id": "1",
   "label": "一つ・一人（数）",
   "def": "数としての1つ・1人。週の初めの日（ μιᾷ σαββάτων ）のように「最初の」の意味でも使う。",
   "note": "MAT 5:18・5:19、MAT 25:15、MAT 28:1（週の初めの日）。"
  },
  {
   "id": "2",
   "label": "ある一つ・一方の",
   "def": "不特定の一人・一つ（ある書記官、など）。対比では「一方の」。",
   "note": "MAT 8:19（ある律法学者）、MAT 6:24（一人を愛し一方を）、JHN 18:39（一人の囚人）。"
  },
  {
   "id": "3",
   "label": "一体の・唯一の",
   "def": "一つに結ばれた一体性、また唯一であること。神は唯一、体は一つ、の用法。",
   "note": "MAT 19:6（一体）、JHN 10:30（一つである）、JHN 17:11、ROM 3:30（神は唯一）。"
  }
 ],
