 "senses": [
  {
   "id": "1",
   "label": "〜から",
   "label_en": "from",
   "label_es": "de",
   "def": "人や神から出て来ること（属格とともに）。",
   "note": ""
  },
  {
   "id": "2",
   "label": "〜のもとに・〜のそばに",
   "label_en": "with / beside",
   "label_es": "con / junto a",
   "def": "人の前・神の前にあること、また場所のそば（与格・対格とともに）。",
   "note": "神の目に、の意味でも使う（LUK 1:30）。"
  },
  {
   "id": "3",
   "label": "〜に反して",
   "label_en": "contrary to",
   "label_es": "contra / contrario a",
   "def": "決まりや性質に逆らうこと（対格とともに）。",
   "note": ""
  },
  {
   "id": "4",
   "label": "〜よりも",
   "label_en": "more than",
   "label_es": "más que",
   "def": "比べる相手を示す（対格とともに）。",
   "note": "2CO 11:24 の「四十から一を差し引いて」もここ。"
  },
  {
   "id": "5",
   "label": "〜のゆえに",
   "label_en": "because of",
   "label_es": "a causa de",
   "def": "理由を示す（1CO 12:15、16 のみ）。",
   "note": ""
  }
 ],
