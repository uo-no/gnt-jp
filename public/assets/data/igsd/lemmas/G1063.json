 "senses": [
  {
   "id": "1",
   "label": "根拠・理由",
   "def": "前の発言・命令・勧めに対して、その理由や根拠を示す働き。「〜だからである」。",
   "note": "MAT 1:21、ROM 1:11。命令の根拠（MAT 3:9）、καὶ γάρ「〜もまた」（MRK 10:45）もここ。"
  },
  {
   "id": "2",
   "label": "説明",
   "def": "前の言葉や場面について、背景となる事実（年齢・身分・習慣・物の性質・定義など）を補って説明する働き。物語の括弧的な注釈に多い。",
   "note": "MRK 5:42（12歳であった）、MRK 7:3（ファリサイ人の習慣）、JHN 4:9、REV 19:8（定義の提示）。"
  },
  {
   "id": "3",
   "label": "疑問・応答",
   "def": "疑問文や応答の冒頭に置かれ、問いや驚きを強める働き。自身は理由を示さない。",
   "note": "MAT 27:23（τί γάρ）、ACT 8:31（πῶς γάρ）、JHN 9:30、PHP 1:18（τί γάρ；）。"
  }
 ],
 "idioms": [
  {
   "form": "καὶ γάρ",
   "gloss": "〜もまた事実",
