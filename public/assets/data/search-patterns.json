{
  "version": 1,
  "description": "パターン検索プリセット（Pattern Search Phase 3）。各パターンは『保存された Term クエリ』であり、解析型ではない。実行は search-tool.html の runTermProximitySearch（事実層の決定的集合演算）のみ。Wallace registry / ClauseAnalyzer には接続しない。Term で表現できないパターンは登録しない（例:『否定＋命令形』は語集合 οὐ/μή… が必要なため Term の集合対応（Phase 4 候補）まで見送り）。",
  "patterns": [
    {
      "id": "hina-subjunctive",
      "label": "目的を表す文",
      "label_en": "Purpose clause",
      "pattern": "ἵνα＋接続法",
      "pattern_en": "ἵνα + subjunctive",
      "description": "「〜するために」という目的を表します",
      "description_en": "Expresses purpose: “in order to …”",
      "query": {
        "type": "cooccurrence",
        "scope": "verse",
        "termA": { "axis": "lemma", "value": "ἵνα" },
        "termB": { "axis": "morph", "field": "mood", "value": "subjunctive" }
      }
    },
    {
      "id": "ean-subjunctive",
      "label": "条件を表す文",
      "label_en": "Conditional clause",
      "pattern": "ἐάν＋接続法",
      "pattern_en": "ἐάν + subjunctive",
      "description": "「もし〜なら」という条件を表します",
      "description_en": "Expresses a condition: “if …”",
      "query": {
        "type": "cooccurrence",
        "scope": "verse",
        "termA": { "axis": "lemma", "value": "ἐάν" },
        "termB": { "axis": "morph", "field": "mood", "value": "subjunctive" }
      }
    },
    {
      "id": "me-command",
      "label": "禁止を表す表現",
      "label_en": "Prohibition",
      "pattern": "μή＋命令形",
      "pattern_en": "μή + imperative",
      "description": "「〜するな」という否定命令を表します",
      "description_en": "Expresses a negative command: “do not …”",
      "query": {
        "type": "cooccurrence",
        "scope": "verse",
        "termA": { "axis": "lemma", "value": "μή" },
        "termB": { "axis": "morph", "field": "mood", "value": "imperative" }
      }
    },
    {
      "id": "reciprocal-command",
      "label": "互いに行う命令",
      "label_en": "Reciprocal command",
      "pattern": "互いに＋命令形",
      "pattern_en": "“one another” + imperative",
      "description": "「互いに〜しなさい」という関係を表します",
      "description_en": "Expresses a mutual relation: “… one another”",
      "query": {
        "type": "cooccurrence",
        "scope": "verse",
        "termA": { "axis": "lemma", "value": "ἀλλήλων" },
        "termB": { "axis": "morph", "field": "mood", "value": "imperative" }
      }
    }
  ]
}
