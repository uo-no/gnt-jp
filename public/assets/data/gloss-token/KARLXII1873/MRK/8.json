  "MRK 8:31!22": "[artikel]",
  "MRK 8:31!23": "af de Skriftlärda,",
  "MRK 8:31!24": "[partikel]",
  "MRK 8:31!25": "och dödas;",
  "MRK 8:31!26": "och",
  "MRK 8:31!27": "[prep.]",
  "MRK 8:31!28": "[absorberad]",
  "MRK 8:31!29": "efter tre dagar",
  "MRK 8:31!30": "uppstå igen.",
  "MRK 8:32!1": "Och",
  "MRK 8:32!2": "uppenbart.",
  "MRK 8:32!3": "[artikel]",
  "MRK 8:32!4": "det talet",
  "MRK 8:32!5": "talade han",
  "MRK 8:32!6": "Då",
  "MRK 8:32!7": "tog Petrus honom till sig,",
  "MRK 8:32!8": "[artikel]",
  "MRK 8:32!9": "[absorberad]",
  "MRK 8:32!10": "[absorberad]",
  "MRK 8:32!11": "och begynte näpsa",
  "MRK 8:32!12": "[absorberad]",
  "MRK 8:32!13": "honom.",
  "MRK 8:33!1": "[artikel]",
  "MRK 8:33!2": "Då",
  "MRK 8:33!3": "vände han sig om,",
  "MRK 8:33!4": "[partikel]",
  "MRK 8:33!5": "och såg",
  "MRK 8:33!6": "[artikel]",
  "MRK 8:33!7": "på sina Lärjungar,",
  "MRK 8:33!8": "[absorberad]",
  "MRK 8:33!9": "och näpste",
  "MRK 8:33!10": "Petrum,",
  "MRK 8:33!11": "[partikel]",
  "MRK 8:33!12": "sägandes:",
  "MRK 8:33!13": "Gack bort",
  "MRK 8:33!14": "[prep.]",
  "MRK 8:33!15": "ifrå mig,",
  "MRK 8:33!16": "du Satan;",
  "MRK 8:33!17": "ty",
  "MRK 8:33!18": "[absorberad]",
  "MRK 8:33!19": "du besinnar icke",
  "MRK 8:33!20": "[artikel]",
  "MRK 8:33!21": "[artikel]",
  "MRK 8:33!22": "det Gudi tillhörer,",
  "MRK 8:33!23": "utan",
  "MRK 8:33!24": "[artikel]",
  "MRK 8:33!25": "[artikel]",
  "MRK 8:33!26": "det menniskor tillhörer.",
  "MRK 8:34!1": "Och",
  "MRK 8:34!2": "kallade han till sig",
  "MRK 8:34!3": "[artikel]",
  "MRK 8:34!4": "folket,",
  "MRK 8:34!5": "[prep.]",
  "MRK 8:34!6": "[artikel]",
  "MRK 8:34!7": "med sina Lärjungar,",
  "MRK 8:34!8": "[absorberad]",
  "MRK 8:34!9": "och sade",
  "MRK 8:34!10": "till dem:",
  "MRK 8:34!11": "[villkor]",
  "MRK 8:34!12": "[absorberad]",
  "MRK 8:34!13": "Den mig vill följa,",
  "MRK 8:34!14": "[prep.]",
  "MRK 8:34!15": "[absorberad]",
  "MRK 8:34!16": "[absorberad]",
  "MRK 8:34!17": "han försake sig sjelf,",
  "MRK 8:34!18": "[absorberad]",
  "MRK 8:34!19": "och",
  "MRK 8:34!20": "tage sitt kors uppå sig,",
  "MRK 8:34!21": "[artikel]",
  "MRK 8:34!22": "[absorberad]",
  "MRK 8:34!23": "[absorberad]",
  "MRK 8:34!24": "och",
  "MRK 8:34!25": "följe mig.",
  "MRK 8:34!26": "[absorberad]",
  "MRK 8:35!1": "[relativ]",
  "MRK 8:35!2": "Ty",
  "MRK 8:35!3": "[partikel]",
  "MRK 8:35!4": "den, som vill",
  "MRK 8:35!5": "[artikel]",
  "MRK 8:35!6": "[absorberad]",
  "MRK 8:35!7": "[absorberad]",
  "MRK 8:35!8": "behålla sitt lif,",
  "MRK 8:35!9": "han skall mista det;",
  "MRK 8:35!10": "[absorberad]",
  "MRK 8:35!11": "[relativ]",
  "MRK 8:35!12": "och",
  "MRK 8:35!13": "[partikel]",
  "MRK 8:35!14": "den som mister",
  "MRK 8:35!15": "[artikel]",
  "MRK 8:35!16": "sitt lif,",
  "MRK 8:35!17": "[absorberad]",
  "MRK 8:35!18": "[prep.]",
  "MRK 8:35!19": "[absorberad]",
  "MRK 8:35!20": "[partikel]",
  "MRK 8:35!21": "[artikel]",
  "MRK 8:35!22": "för mina och Evangelii skull,",
  "MRK 8:35!23": "han skall det behålla.",
  "MRK 8:35!24": "[absorberad]",
  "MRK 8:36!1": "hvad",
  "MRK 8:36!2": "Ty",
  "MRK 8:36!3": "hjelper det",
  "MRK 8:36!4": "menniskone,",
  "MRK 8:36!5": "om hon kunde vinna",
  "MRK 8:36!6": "[artikel]",
  "MRK 8:36!7": "hela verldena,",
  "MRK 8:36!8": "[absorberad]",
  "MRK 8:36!9": "och",
  "MRK 8:36!10": "toge skada",
  "MRK 8:36!11": "[artikel]",
  "MRK 8:36!12": "till sin själ?",
  "MRK 8:36!13": "[absorberad]",
  "MRK 8:37!1": "hvad",
  "MRK 8:37!2": "Eller",
  "MRK 8:37!3": "kan en menniska gifva,",
  "MRK 8:37!4": "[absorberad]",
  "MRK 8:37!5": "der hon sin själ med lösa må?",
  "MRK 8:37!6": "[artikel]",
  "MRK 8:37!7": "[absorberad]",
  "MRK 8:37!8": "[absorberad]",
  "MRK 8:38!1": "[relativ]",
  "MRK 8:38!2": "Men",
  "MRK 8:38!3": "[partikel]",
  "MRK 8:38!4": "den som blyges",
  "MRK 8:38!5": "vid mig",
  "MRK 8:38!6": "[partikel]",
  "MRK 8:38!7": "[artikel]",
  "MRK 8:38!8": "[absorberad]",
  "MRK 8:38!9": "och min ord,",
  "MRK 8:38!10": "[prep.]",
  "MRK 8:38!11": "[artikel]",
  "MRK 8:38!12": "slägtet,",
  "MRK 8:38!13": "uti detta",
  "MRK 8:38!14": "[artikel]",
  "MRK 8:38!15": "horiska",
  "MRK 8:38!16": "och",
  "MRK 8:38!17": "syndiga",
  "MRK 8:38!18": "[absorberad]",
  "MRK 8:38!19": "[artikel]",
  "MRK 8:38!20": "[absorberad]",
  "MRK 8:38!21": "[artikel]",
  "MRK 8:38!22": "[absorberad]",
  "MRK 8:38!23": "skall ock menniskones Son blygas,",
  "MRK 8:38!24": "vid honom",
  "MRK 8:38!25": "[partikel]",
  "MRK 8:38!26": "när han kommer",
  "MRK 8:38!27": "[prep.]",
  "MRK 8:38!28": "[artikel]",
  "MRK 8:38!29": "i sins Faders härlighet,",
  "MRK 8:38!30": "[artikel]",
  "MRK 8:38!31": "[absorberad]",
  "MRK 8:38!32": "[absorberad]",
  "MRK 8:38!33": "[prep.]",
  "MRK 8:38!34": "[artikel]",
  "MRK 8:38!35": "med de helga Änglar.",
  "MRK 8:38!36": "[artikel]",
  "MRK 8:38!37": "[absorberad]"
 }
}