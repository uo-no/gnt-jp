  "MRK 11:28!7": "[absorberad]",
  "MRK 11:28!8": "gör du detta?",
  "MRK 11:28!9": "Och",
  "MRK 11:28!10": "hvilken",
  "MRK 11:28!11": "[absorberad]",
  "MRK 11:28!12": "hafver gifvit dig",
  "MRK 11:28!13": "[artikel]",
  "MRK 11:28!14": "denna magten,",
  "MRK 11:28!15": "[absorberad]",
  "MRK 11:28!16": "[partikel]",
  "MRK 11:28!17": "[absorberad]",
  "MRK 11:28!18": "att du detta göra skall?",
  "MRK 11:29!1": "[artikel]",
  "MRK 11:29!2": "[partikel]",
  "MRK 11:29!3": "Jesus svarade,",
  "MRK 11:29!4": "och sade",
  "MRK 11:29!5": "till dem:",
  "MRK 11:29!6": "Jag vill ock något spörja",
  "MRK 11:29!7": "eder;",
  "MRK 11:29!8": "[absorberad]",
  "MRK 11:29!9": "[absorberad]",
  "MRK 11:29!10": "[partikel]",
  "MRK 11:29!11": "svarer mig,",
  "MRK 11:29!12": "[absorberad]",
  "MRK 11:29!13": "så",
  "MRK 11:29!14": "vill jag säga",
  "MRK 11:29!15": "eder,",
  "MRK 11:29!16": "[prep.]",
  "MRK 11:29!17": "[absorberad]",
  "MRK 11:29!18": "af hvad magt",
  "MRK 11:29!19": "[absorberad]",
  "MRK 11:29!20": "jag detta gör.",
  "MRK 11:30!1": "[artikel]",
  "MRK 11:30!2": "Johannis döpelse,",
  "MRK 11:30!3": "[artikel]",
  "MRK 11:30!4": "[absorberad]",
  "MRK 11:30!5": "[prep.]",
  "MRK 11:30!6": "af himmelen,",
  "MRK 11:30!7": "var den",
  "MRK 11:30!8": "eller",
  "MRK 11:30!9": "[prep.]",
  "MRK 11:30!10": "af menniskor?",
  "MRK 11:30!11": "Svarer mig.",
  "MRK 11:30!12": "[absorberad]",
  "MRK 11:31!1": "Och",
  "MRK 11:31!2": "de tänkte",
  "MRK 11:31!3": "[prep.]",
  "MRK 11:31!4": "vid sig,",
  "MRK 11:31!5": "och sade:",
  "MRK 11:31!8": "[villkor]",
  "MRK 11:31!9": "Säge vi,",
  "MRK 11:31!10": "[prep.]",
  "MRK 11:31!11": "af himmelen;",
  "MRK 11:31!12": "då säger han:",
  "MRK 11:31!13": "[prep.]",
  "MRK 11:31!14": "Hvi",
  "MRK 11:31!15": "då?",
  "MRK 11:31!16": "honom icke",
  "MRK 11:31!17": "trodden I",
  "MRK 11:31!18": "[absorberad]",
  "MRK 11:32!1": "Men",
  "MRK 11:32!2": "säge vi,",
  "MRK 11:32!3": "[prep.]",
  "MRK 11:32!4": "af menniskom,",
  "MRK 11:32!5": "rädes vi",
  "MRK 11:32!6": "[artikel]",
  "MRK 11:32!7": "för folket;",
  "MRK 11:32!8": "[absorberad]",
  "MRK 11:32!9": "ty",
  "MRK 11:32!10": "alle höllo",
  "MRK 11:32!11": "[artikel]",
  "MRK 11:32!12": "Johannes",
  "MRK 11:32!13": "[absorberad]",
  "MRK 11:32!14": "[innehåll]",
  "MRK 11:32!15": "[absorberad]",
  "MRK 11:32!16": "för en sann Prophet.",
  "MRK 11:33!1": "Och",
  "MRK 11:33!2": "så svarade de,",
  "MRK 11:33!3": "[artikel]",
  "MRK 11:33!4": "[absorberad]",
  "MRK 11:33!5": "sägande till Jesum:",
  "MRK 11:33!6": "[absorberad]",
  "MRK 11:33!7": "Vi vete det icke.",
  "MRK 11:33!8": "[partikel]",
  "MRK 11:33!9": "[artikel]",
  "MRK 11:33!10": "Svarade Jesus,",
  "MRK 11:33!11": "och sade",
  "MRK 11:33!12": "till dem:",
  "MRK 11:33!13": "Icke heller",
  "MRK 11:33!14": "[absorberad]",
  "MRK 11:33!15": "säger jag eder,",
  "MRK 11:33!16": "[absorberad]",
  "MRK 11:33!17": "[prep.]",
  "MRK 11:33!18": "[absorberad]",
  "MRK 11:33!19": "af hvad magt",
  "MRK 11:33!20": "[absorberad]",
  "MRK 11:33!21": "jag detta gör."
 }
