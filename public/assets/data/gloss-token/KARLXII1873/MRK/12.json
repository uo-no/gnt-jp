  "MRK 12:28!10": "[innehåll]",
  "MRK 12:28!11": "[absorberad]",
  "MRK 12:28!12": "att han hade väl svarat dem,",
  "MRK 12:28!13": "[absorberad]",
  "MRK 12:28!14": "och sporde",
  "MRK 12:28!15": "honom till:",
  "MRK 12:28!16": "[absorberad]",
  "MRK 12:28!17": "Hvilket är det",
  "MRK 12:28!18": "af all budorden?",
  "MRK 12:28!19": "yppersta",
  "MRK 12:28!20": "[absorberad]",
