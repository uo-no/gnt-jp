  "MRK 12:30!4": "[artikel]",
  "MRK 12:30!5": "[absorberad]",
  "MRK 12:30!6": "[absorberad]",
  "MRK 12:30!7": "[prep.]",
  "MRK 12:30!8": "[absorberad]",
  "MRK 12:30!9": "[artikel]",
  "MRK 12:30!10": "af allt ditt hjerta,",
