  "MRK 12:28!3": "[absorberad]",
  "MRK 12:28!4": "[artikel]",
  "MRK 12:28!5": "af de Skriftlärda,",
  "MRK 12:28!6": "den derpå hört hade,",
  "MRK 12:28!7": "[absorberad]",
