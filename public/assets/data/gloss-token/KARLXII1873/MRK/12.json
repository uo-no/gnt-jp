  "MRK 12:30!25": "[prep.]",
  "MRK 12:30!26": "[absorberad]",
  "MRK 12:30!27": "[artikel]",
  "MRK 12:30!28": "af allo dine magt.",
  "MRK 12:30!29": "[absorberad]",
