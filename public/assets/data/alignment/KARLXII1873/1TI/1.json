  "verses": {
    "1": {
      "segments": [
        {
          "t": "Paulus, Jesu Christi Apostel, ",
          "tokens": [
            1,
            2,
            3,
            4
          ]
        },
        {
          "t": "efter Guds vår Frälsares och Herrans Jesu Christi befallning, ",
