  "verses": {
    "1": {
      "segments": [
        {
          "t": "Therefore I urge you, brothers, ",
          "tokens": [
            1,
            2,
            3,
            4
          ]
        },
        {
          "t": "by the mercies of God, ",
          "tokens": [
            5,
            6,
            7,
            8,
            9
          ]
        },
        {
          "t": "to present your bodies a living sacrifice, ",
          "tokens": [
            10,
            11,
            12,
            13,
            14,
            15
          ]
        },
        {
          "t": "holy, acceptable to God, ",
          "tokens": [
            16,
            17,
            18,
            19
          ]
        },
        {
          "t": "which is your spiritual service.",
          "tokens": [
            20,
            21,
            22,
            23
          ]
        }
      ]
    },
    "2": {
      "segments": [
        {
